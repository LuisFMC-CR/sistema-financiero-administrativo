<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Las pruebas SqlServer comparten la fila singleton de ParametrosSistema y las filas de
         AccountingPeriodOverride contra la misma base real; correrlas en paralelo entre clases
         produce choques intermitentes entre transacciones concurrentes. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SistemaFinanciero.Web\SistemaFinanciero.Web.csproj" />
    <ProjectReference Include="..\..\src\SistemaFinanciero.Infrastructure\SistemaFinanciero.Infrastructure.csproj" />
  </ItemGroup>

</Project>
