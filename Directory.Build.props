<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Los tipos públicos se documentan cuando forman parte de un contrato o una regla de dominio. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Una salida de compilación en artifacts/ dentro de un proyecto no debe tomarse como contenido:
         se copiaba a bin/ y se anidaba en cada compilación. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
