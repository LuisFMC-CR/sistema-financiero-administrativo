@using SistemaFinanciero.Application.Budgets
@using SistemaFinanciero.Web.Models.Budgets
@model BudgetIndexViewModel
@{
    ViewData["Title"] = "Presupuesto";
    DateOnly currentPeriod = new(Model.PeriodYear, Model.PeriodMonth, 1);
    DateOnly previousPeriod = currentPeriod.AddMonths(-1);
    DateOnly nextPeriod = currentPeriod.AddMonths(1);
    // La aplicación fija la cultura es-CR en Program.cs, así que el mes sale en español sin indicarla aquí.
    string periodLabel = currentPeriod.ToString("MMMM yyyy");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="h2 mb-1">Presupuesto</h1>
        <p class="text-body-secondary mb-0">Mensual, por categoría de gasto de último nivel; las superiores solo suman. Ejecutado sin IVA.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-year="@previousPeriod.Year" asp-route-month="@previousPeriod.Month" asp-route-filter="@Model.Filter">« Anterior</a>
        <span class="fw-semibold text-capitalize">@periodLabel</span>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-year="@nextPeriod.Year" asp-route-month="@nextPeriod.Month" asp-route-filter="@Model.Filter">Siguiente »</a>
        @if (Model.CanEditPeriod)
        {
            <a class="btn btn-primary btn-sm" asp-action="Create" asp-route-year="@Model.PeriodYear" asp-route-month="@Model.PeriodMonth">Agregar línea</a>
        }
    </div>
</div>

@if (!Model.CanEditPeriod)
{
    <div class="alert alert-info" role="status">
        Este período es anterior al mes actual; puede consultarlo, pero no crear ni modificar presupuestos.
    </div>
}

<form method="get" asp-action="Index" class="row gy-2 gx-3 align-items-end mb-3">
    <input type="hidden" name="year" value="@Model.PeriodYear" />
    <input type="hidden" name="month" value="@Model.PeriodMonth" />
    <div class="col-auto">
        <label class="form-label small mb-0" for="filter">Mostrar</label>
        <select class="form-select form-select-sm" id="filter" name="filter" onchange="this.form.submit()">
            <option value="@BudgetListFilter.OnlyWithBudget" selected="@(Model.Filter == BudgetListFilter.OnlyWithBudget)">Solo con presupuesto</option>
            <option value="@BudgetListFilter.All" selected="@(Model.Filter == BudgetListFilter.All)">Todas</option>
        </select>
    </div>
</form>

<div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">Categoría</th>
                <th scope="col" class="text-end">Presupuestado</th>
                <th scope="col" class="text-end">Ejecutado</th>
                <th scope="col" class="text-end">Disponible</th>
                <th scope="col" class="text-end">% Utilizado</th>
                <th scope="col">Ejecución</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Results.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-body-secondary py-4">No hay categorías para los filtros indicados.</td></tr>
            }
            @foreach (BudgetModel budget in Model.Results)
            {
                <tr>
                    <td>@budget.AccountCode - @budget.AccountName</td>
                    <td class="text-end">@(budget.BudgetedAmount is decimal budgeted ? $"₡{budgeted:N2}" : "Sin presupuesto")</td>
                    <td class="text-end">₡@budget.ExecutedAmount.ToString("N2")</td>
                    <td class="text-end">@(budget.AvailableAmount is decimal available ? $"₡{available:N2}" : "—")</td>
                    <td class="text-end">@(budget.BudgetedAmount is decimal budgetAmount && budgetAmount > 0 ? (budget.ExecutedAmount / budgetAmount).ToString("P1") : "—")</td>
                    <td><partial name="_BudgetExecutionBadge" model="budget.ExecutionStatus" /></td>
                    <td class="text-end">
                        @if (Model.CanEditPeriod)
                        {
                            <a asp-action="Edit" asp-route-accountId="@budget.AccountId" asp-route-year="@Model.PeriodYear" asp-route-month="@Model.PeriodMonth" class="btn btn-sm btn-outline-primary">Editar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
