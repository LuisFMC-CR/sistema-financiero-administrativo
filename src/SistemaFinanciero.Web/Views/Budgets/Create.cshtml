@using SistemaFinanciero.Web.Models.Budgets
@model BudgetCreateViewModel
@{
    ViewData["Title"] = "Agregar línea de presupuesto";
    DateOnly period = new(Model.PeriodYear, Model.PeriodMonth, 1);
}

<div class="catalog-form">
    <h1 class="h2">Agregar línea de presupuesto</h1>
    <p class="text-body-secondary">
        @period.ToString("MMMM yyyy").
    </p>
    @if (Model.CategoryOptions.Count == 0)
    {
        <p class="text-body-secondary">
            Todas las categorías de gasto de último nivel ya tienen presupuesto para este mes. Para
            corregir un monto, use "Editar" en la tabla del mes.
        </p>
        <a asp-action="Index" asp-route-year="@Model.PeriodYear" asp-route-month="@Model.PeriodMonth" class="btn btn-outline-secondary">Volver</a>
    }
    else
    {
        <form method="post" class="card card-body">
            <input asp-for="PeriodYear" type="hidden" />
            <input asp-for="PeriodMonth" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                    <option value="">Seleccione una categoría de gasto</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
                <div class="form-text">Un monto de ₡0 es válido.</div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Agregar línea</button>
                <a asp-action="Index" asp-route-year="@Model.PeriodYear" asp-route-month="@Model.PeriodMonth" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
