@model FinancialAccountCreateViewModel
@{
    ViewData["Title"] = "Nueva cuenta financiera";
}

<div class="catalog-form">
    <h1 class="h2">Nueva cuenta financiera</h1>
    <p class="text-body-secondary">El tipo y la moneda quedarán fijos después de crear la cuenta.</p>
    <form asp-action="Create" method="post" class="card card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control text-uppercase" autocomplete="off" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" class="form-select">
                    <option value="Cash">Caja</option>
                    <option value="Bank">Cuenta bancaria</option>
                </select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Currency" class="form-label"></label>
                <select asp-for="Currency" class="form-select">
                    <option value="CRC">CRC - Colón costarricense</option>
                    <option value="USD">USD - Dólar estadounidense</option>
                </select>
                <span asp-validation-for="Currency" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Reference" class="form-label"></label>
                <input asp-for="Reference" class="form-control" autocomplete="off" />
                <span asp-validation-for="Reference" class="text-danger"></span>
                <div class="form-text">Puede ser una referencia interna o los últimos dígitos; no ingrese credenciales bancarias.</div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar cuenta</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

