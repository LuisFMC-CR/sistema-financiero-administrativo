@model FinancialAccountEditViewModel
@{
    ViewData["Title"] = "Editar cuenta financiera";
}

<div class="catalog-form">
    <h1 class="h2">Editar cuenta financiera</h1>
    <p class="text-body-secondary">El tipo y la moneda no pueden modificarse para preservar la consistencia de los movimientos.</p>
    <form method="post" asp-antiforgery="true" class="card card-body">
        <input asp-for="Version" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control text-uppercase" autocomplete="off" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Tipo</label>
                <input value="@Model.Type.ToDisplayName()" class="form-control" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label">Moneda</label>
                <input value="@Model.Currency.ToDisplayName()" class="form-control" readonly />
            </div>
            <div class="col-12">
                <label asp-for="Reference" class="form-label"></label>
                <input asp-for="Reference" class="form-control" autocomplete="off" />
                <span asp-validation-for="Reference" class="text-danger"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
