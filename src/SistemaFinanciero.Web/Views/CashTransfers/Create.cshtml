@using SistemaFinanciero.Web.Models.CashTransfers
@model CreateCashTransferViewModel
@{
    ViewData["Title"] = "Nuevo traspaso";
}

<div class="catalog-form">
    <h1 class="h2">Nuevo traspaso</h1>
    <p class="text-body-secondary">
        Mueve dinero entre dos cuentas de efectivo propias: no es un ingreso ni un gasto, y no afecta
        categorías, presupuesto ni estado de resultados.
    </p>
    <form method="post" class="card card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="SourceCashAccountId" class="form-label"></label>
                <select asp-for="SourceCashAccountId" asp-items="Model.SourceCashAccountOptions" class="form-select" onchange="if (this.value) { window.location.href = '@Url.Action(nameof(SistemaFinanciero.Web.Controllers.CashTransfersController.Create))?sourceCashAccountId=' + this.value; }">
                    <option value="">Seleccione una cuenta de origen</option>
                </select>
                <span asp-validation-for="SourceCashAccountId" class="text-danger"></span>
                @if (Model.SourceCashAccountBalance is decimal balance)
                {
                    <div class="form-text">Saldo informativo según los asientos: ₡@balance.ToString("N2"). No bloquea el registro.</div>
                }
            </div>
            <div class="col-md-6">
                <label asp-for="DestinationCashAccountId" class="form-label"></label>
                <select asp-for="DestinationCashAccountId" asp-items="Model.DestinationCashAccountOptions" class="form-select">
                    <option value="">Seleccione una cuenta de destino</option>
                </select>
                <span asp-validation-for="DestinationCashAccountId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="TransferDate" class="form-label"></label>
                <input asp-for="TransferDate" type="date" class="form-control" />
                <span asp-validation-for="TransferDate" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Reference" class="form-label"></label>
                <input asp-for="Reference" class="form-control" placeholder="N.° de transferencia, depósito o comprobante" />
                <span asp-validation-for="Reference" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2" placeholder="Explique el motivo del traspaso, por ejemplo: depósito de caja chica al banco."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">Registrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
