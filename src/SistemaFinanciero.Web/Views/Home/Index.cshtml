@{
    ViewData["Title"] = "Inicio";
}

<div class="py-4">
    <div class="p-4 p-lg-5 bg-body-tertiary rounded-3 border">
        <p class="text-uppercase text-secondary small fw-semibold mb-2">Soporte Experto</p>
        <h1 class="display-6 fw-semibold">Control financiero-administrativo</h1>
        <p class="lead mb-0">
            La base segura del sistema está preparada. Los módulos operativos se incorporarán por incrementos.
        </p>
    </div>

    <div class="row g-3 mt-2">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Seguridad</h2>
                    <p class="text-secondary mb-0">Acceso interno, roles y políticas evaluadas en el servidor.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Monedas</h2>
                    <p class="text-secondary mb-0">Operaciones en CRC y USD con CRC como moneda base.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Trazabilidad</h2>
                    <p class="text-secondary mb-0">Decisiones, requisitos y pruebas vinculados desde el inicio.</p>
                </div>
            </div>
        </div>
    </div>
</div>
