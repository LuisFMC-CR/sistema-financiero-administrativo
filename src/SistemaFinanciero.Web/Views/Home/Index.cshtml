@using SistemaFinanciero.Web.Models.Overdue
@model OverdueIndicatorViewModel?
@{
    ViewData["Title"] = "Inicio";
}

<div class="py-4">
    <div class="p-4 p-lg-5 bg-body-tertiary rounded-3 border">
        <p class="text-uppercase text-secondary small fw-semibold mb-2">Soporte Experto</p>
        <h1 class="display-6 fw-semibold">Control financiero-administrativo</h1>
        <p class="lead mb-0">
            Sistema interno en colones para el control de facturación, cuentas por cobrar y por pagar,
            ingresos, gastos y presupuesto.
        </p>
    </div>

    @if (Model is not null)
    {
        <div class="mt-3">
            <partial name="_OverdueIndicator" model="Model" />
        </div>
    }
</div>
