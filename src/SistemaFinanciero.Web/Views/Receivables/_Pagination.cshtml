@using SistemaFinanciero.Web.Models.Receivables
@model ReceivableIndexViewModel

@if (Model.Results.TotalPages > 1)
{
    <nav aria-label="Paginación de cuentas por cobrar" class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <span class="text-body-secondary">Página @Model.Results.Page de @Model.Results.TotalPages</span>
        <ul class="pagination mb-0">
            <li class="page-item @(!Model.Results.HasPreviousPage ? "disabled" : null)">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-invoiceNumber="@Model.Query.InvoiceNumber"
                   asp-route-customerName="@Model.Query.CustomerName"
                   asp-route-balanceMin="@Model.Query.BalanceMin"
                   asp-route-balanceMax="@Model.Query.BalanceMax"
                   asp-route-dueDateFrom="@Model.Query.DueDateFrom"
                   asp-route-dueDateTo="@Model.Query.DueDateTo"
                   asp-route-status="@Model.Query.Status"
                   asp-route-page="@(Model.Results.Page - 1)"
                   aria-disabled="@(!Model.Results.HasPreviousPage)">Anterior</a>
            </li>
            <li class="page-item @(!Model.Results.HasNextPage ? "disabled" : null)">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-invoiceNumber="@Model.Query.InvoiceNumber"
                   asp-route-customerName="@Model.Query.CustomerName"
                   asp-route-balanceMin="@Model.Query.BalanceMin"
                   asp-route-balanceMax="@Model.Query.BalanceMax"
                   asp-route-dueDateFrom="@Model.Query.DueDateFrom"
                   asp-route-dueDateTo="@Model.Query.DueDateTo"
                   asp-route-status="@Model.Query.Status"
                   asp-route-page="@(Model.Results.Page + 1)"
                   aria-disabled="@(!Model.Results.HasNextPage)">Siguiente</a>
            </li>
        </ul>
    </nav>
}
