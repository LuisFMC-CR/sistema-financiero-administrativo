@using SistemaFinanciero.Web.Models.Parameters
@model SystemParametersPageViewModel
@{
    ViewData["Title"] = "Parámetros del sistema";
    bool canManage = (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ManageSystemParameters)).Succeeded;
    bool isConfigured = !string.IsNullOrEmpty(Model.Parameters.Version);
}

<div class="mb-3">
    <h1 class="h2 mb-1">Parámetros del sistema</h1>
    <p class="text-body-secondary mb-0">Límite de autorización de abonos y pagos, días de alerta de vencimiento próximo, y fecha de cierre.</p>
</div>

@if (!isConfigured && !canManage)
{
    <div class="alert alert-warning" role="status">Gerencia todavía no ha configurado los parámetros del sistema.</div>
}
else
{
    <div class="catalog-form mb-4">
        <form asp-action="Save" method="post" class="card card-body">
            <input asp-for="Parameters.Version" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Parameters.AuthorizationLimitCrc" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">CRC</span>
                        @if (canManage)
                        {
                            <input asp-for="Parameters.AuthorizationLimitCrc" type="number" min="0" step="0.01" class="form-control" />
                        }
                        else
                        {
                            <input value="@Model.Parameters.AuthorizationLimitCrc.ToString("N2", System.Globalization.CultureInfo.CurrentCulture)" class="form-control" readonly />
                        }
                    </div>
                    <span asp-validation-for="Parameters.AuthorizationLimitCrc" class="text-danger"></span>
                    <div class="form-text">Los abonos y pagos por encima de este monto solo los registra Gerencia.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Parameters.OverdueAlertDays" class="form-label"></label>
                    @if (canManage)
                    {
                        <input asp-for="Parameters.OverdueAlertDays" type="number" min="1" max="3650" class="form-control" />
                    }
                    else
                    {
                        <input value="@Model.Parameters.OverdueAlertDays" class="form-control" readonly />
                    }
                    <span asp-validation-for="Parameters.OverdueAlertDays" class="text-danger"></span>
                    <div class="form-text">Anticipación para marcar una cuenta por cobrar o por pagar como próxima a vencer.</div>
                </div>
            </div>
            @if (isConfigured)
            {
                <p class="text-body-secondary small mt-3 mb-0">
                    Última modificación: @Model.Parameters.UpdatedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") por @Model.Parameters.UpdatedByUserName.
                </p>
            }
            @if (canManage)
            {
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Guardar parámetros</button>
                </div>
            }
        </form>
    </div>

    @if (isConfigured)
    {
        <div class="catalog-form">
            <h2 class="h5">Fecha de cierre</h2>
            <p class="text-body-secondary small">
                No se registra, confirma, anula ni ajusta nada con fecha igual o anterior a la de cierre.
                Adelantarla es el cierre mensual (sin motivo); retrocederla es una reapertura y exige motivo
                (regla de negocio 16). Nunca puede ser posterior a hoy.
            </p>
            <form asp-action="ChangeClosingDate" method="post" class="card card-body">
                <input asp-for="ClosingDateForm.Version" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Fecha de cierre vigente</label>
                        <input value="@Model.Parameters.ClosingDate.ToString("dd/MM/yyyy")" class="form-control" readonly />
                    </div>
                    @if (canManage)
                    {
                        <div class="col-md-6">
                            <label asp-for="ClosingDateForm.NewClosingDate" class="form-label"></label>
                            <input asp-for="ClosingDateForm.NewClosingDate" type="date" class="form-control" />
                            <span asp-validation-for="ClosingDateForm.NewClosingDate" class="text-danger"></span>
                        </div>
                    }
                </div>
                @if (canManage)
                {
                    <div class="mt-3">
                        <label asp-for="ClosingDateForm.Reason" class="form-label"></label>
                        <textarea asp-for="ClosingDateForm.Reason" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="ClosingDateForm.Reason" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-warning">Cambiar fecha de cierre</button>
                    </div>
                }
            </form>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
