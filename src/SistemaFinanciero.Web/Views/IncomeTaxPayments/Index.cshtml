@using Microsoft.AspNetCore.Mvc.Rendering
@using SistemaFinanciero.Application.IncomeTax
@using SistemaFinanciero.Application.Security
@using SistemaFinanciero.Domain.IncomeTax
@using SistemaFinanciero.Web.Models.IncomeTax
@model IncomeTaxPaymentIndexViewModel
@{
    ViewData["Title"] = "Pagos de renta";
    bool canCreate = (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ConfirmFinancialTransactions)).Succeeded;
    bool canCancel = (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.VoidFinancialTransactions)).Succeeded;
    bool canViewReports = (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ViewFinancialReports)).Succeeded;
    int columnCount = canCancel ? 6 : 5;
    string? selectedPeriod = Model.Query.FiscalPeriodStartDate?.ToString("yyyy-MM-dd");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="h2 mb-1">Pagos de impuesto sobre la renta</h1>
        <p class="text-body-secondary mb-0">
            Pagos parciales y de la declaración hechos a Hacienda. Se restan en la estimación del período fiscal al que se aplican.
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (canViewReports)
        {
            <a asp-controller="Reports" asp-action="IncomeTaxEstimate" class="btn btn-outline-secondary">Ver estimación</a>
        }
        @if (canCreate)
        {
            <a asp-action="Create" class="btn btn-primary">Nuevo pago</a>
        }
    </div>
</div>

<form method="get" role="search">
<div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">Fecha</th>
                <th scope="col">Período fiscal</th>
                <th scope="col">Cuenta de efectivo</th>
                <th scope="col" class="text-end">Monto</th>
                <th scope="col">Estado</th>
                @if (canCancel)
                {
                    <th scope="col" class="text-end">Acciones</th>
                }
            </tr>
            <tr class="table-filter-row">
                <th class="p-2">
                    <div class="d-flex gap-1">
                        <input name="paymentDateFrom" type="date" value="@Model.Query.PaymentDateFrom?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="Fecha desde" />
                        <input name="paymentDateTo" type="date" value="@Model.Query.PaymentDateTo?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="Fecha hasta" />
                    </div>
                </th>
                <th class="p-2">
                    <select name="fiscalPeriodStartDate" class="form-select form-select-sm" aria-label="Filtrar por período fiscal">
                        <option value="">Todos</option>
                        @foreach (SelectListItem option in Model.FiscalPeriodOptions)
                        {
                            <option value="@option.Value" selected="@(option.Value == selectedPeriod)">@option.Text</option>
                        }
                    </select>
                </th>
                <th class="p-2">
                    <div class="d-flex gap-1">
                        <select name="cashAccountId" class="form-select form-select-sm" aria-label="Filtrar por cuenta de efectivo">
                            <option value="">Todas</option>
                            @foreach (SelectListItem option in Model.CashAccountOptions)
                            {
                                <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                            }
                        </select>
                        <input name="code" value="@Model.Query.Code" class="form-control form-control-sm" placeholder="Código" aria-label="Filtrar por código" />
                    </div>
                </th>
                <th class="p-2"></th>
                <th class="p-2">
                    <select name="status" class="form-select form-select-sm" aria-label="Filtrar por estado">
                        @foreach (IncomeTaxPaymentStatusFilter status in Enum.GetValues<IncomeTaxPaymentStatusFilter>())
                        {
                            <option value="@status" selected="@(status == Model.Query.Status)">@status.ToDisplayName()</option>
                        }
                    </select>
                </th>
                @if (canCancel)
                {
                    <th class="p-2"></th>
                }
            </tr>
            <tr>
                <th colspan="@columnCount" class="p-2 text-end">
                    <button type="submit" class="btn btn-sm btn-primary" aria-label="Buscar pagos" title="Buscar">
                        <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5" /><path d="m10.5 10.5 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary" aria-label="Limpiar filtros" title="Limpiar">
                        <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 4h10M6 4V2.5h4V4m2 0-.6 9H4.6L4 4m2.5 2v4.5m3-4.5v4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </a>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Results.Items.Count == 0)
            {
                <tr><td colspan="@columnCount" class="text-center text-body-secondary py-4">No se encontraron pagos.</td></tr>
            }
            @foreach (IncomeTaxPaymentModel payment in Model.Results.Items)
            {
                <tr>
                    <td class="fw-semibold">
                        <a asp-action="Details" asp-route-id="@payment.Id">@payment.PaymentDate.ToString("dd/MM/yyyy")</a>
                        <br /><small class="text-body-secondary">@payment.Code</small>
                    </td>
                    <td>@payment.FiscalPeriodStartDate.ToFiscalPeriodLabel()</td>
                    <td>@payment.CashAccountName</td>
                    <td class="text-end">₡@payment.Amount.ToString("N2")</td>
                    <td>
                        @payment.Status.ToDisplayName()
                        @if (payment.Status == IncomeTaxPaymentStatus.Cancelled && !string.IsNullOrWhiteSpace(payment.CancellationReason))
                        {
                            <br /><small class="text-body-secondary">@payment.CancellationReason</small>
                        }
                    </td>
                    @if (canCancel)
                    {
                        <td class="text-end">
                            @if (payment.Status == IncomeTaxPaymentStatus.Active)
                            {
                                <a asp-action="Cancel" asp-route-id="@payment.Id" class="btn btn-sm btn-outline-danger">Anular</a>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
</form>

<partial name="_Pagination" model="Model" />
