@using SistemaFinanciero.Application.IncomeTax
@using SistemaFinanciero.Application.Security
@using SistemaFinanciero.Domain.IncomeTax
@using SistemaFinanciero.Domain.Ledger
@using SistemaFinanciero.Web.Models.IncomeTax
@using SistemaFinanciero.Web.Models.Invoices
@model IncomeTaxPaymentDetailsViewModel
@{
    ViewData["Title"] = "Detalle de pago de renta";
    IncomeTaxPaymentModel payment = Model.Payment;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="h2 mb-1">Pago de renta @payment.Code</h1>
        <p class="text-body-secondary mb-0">
            Estado: <strong>@payment.Status.ToDisplayName()</strong>
            @if (payment.Status == IncomeTaxPaymentStatus.Cancelled && !string.IsNullOrWhiteSpace(payment.CancellationReason))
            {
                <text> — Motivo: @payment.CancellationReason</text>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.CanCancel)
        {
            <a asp-action="Cancel" asp-route-id="@payment.Id" class="btn btn-danger">Anular</a>
        }
        @if ((await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ViewFinancialReports)).Succeeded)
        {
            <a asp-controller="JournalEntries" asp-action="Trace"
               asp-route-sourceType="@((int)JournalEntrySourceType.IncomeTaxPayment)" asp-route-sourceId="@payment.Id"
               class="btn btn-outline-secondary">Ver asiento</a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card card-body h-100">
            <h2 class="h5">Período y cuenta</h2>
            <p class="mb-1">Período fiscal: @payment.FiscalPeriodStartDate.ToFiscalPeriodLabel()</p>
            <p class="mb-1">Cuenta de efectivo: @payment.CashAccountName</p>
            <p class="mb-0">Medio de pago: @payment.PaymentMethod.ToDisplayName()</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card card-body h-100">
            <h2 class="h5">Monto y referencia</h2>
            <p class="mb-1 fw-semibold">₡@payment.Amount.ToString("N2")</p>
            <p class="mb-1">Fecha: @payment.PaymentDate.ToString("dd/MM/yyyy")</p>
            <p class="mb-1">Referencia: @payment.Reference</p>
            <p class="mb-0">Descripción: @(string.IsNullOrWhiteSpace(payment.Description) ? "—" : payment.Description)</p>
        </div>
    </div>
</div>
