@model DailyExchangeRateEditViewModel
@{
    ViewData["Title"] = "Editar tipo de cambio";
}

<div class="catalog-form catalog-form-narrow">
    <h1 class="h2">Editar tipo de cambio</h1>
    <p class="text-body-secondary">La corrección queda protegida contra modificaciones simultáneas.</p>
    <form method="post" asp-antiforgery="true" class="card card-body">
        <input asp-for="Version" type="hidden" />
        <partial name="_Form" model="Model" />
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
