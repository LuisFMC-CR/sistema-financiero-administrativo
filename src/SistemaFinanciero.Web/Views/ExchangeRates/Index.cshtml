@model PagedIndexViewModel<DailyExchangeRateModel>
@{
    ViewData["Title"] = "Tipos de cambio";
    bool canManage = (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ManageBusinessCatalogs)).Succeeded;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="h2 mb-1">Tipos de cambio</h1>
        <p class="text-body-secondary mb-0">Cantidad de colones costarricenses equivalente a un dólar para cada fecha.</p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">Nuevo tipo de cambio</a>
    }
</div>

<partial name="_CatalogFilters" model="new CatalogFilterViewModel(Model.Search)" />

<div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">Fecha efectiva</th>
                <th scope="col" class="text-end">CRC por USD</th>
                <th scope="col">Fuente</th>
                <th scope="col">Observaciones</th>
                @if (canManage)
                {
                    <th scope="col" class="text-end">Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Results.Items.Count == 0)
            {
                <tr><td colspan="@(canManage ? 5 : 4)" class="text-center text-body-secondary py-4">No se encontraron tipos de cambio.</td></tr>
            }
            @foreach (DailyExchangeRateModel exchangeRate in Model.Results.Items)
            {
                <tr>
                    <td>@exchangeRate.EffectiveDate.ToString("dd/MM/yyyy")</td>
                    <td class="text-end fw-semibold">@exchangeRate.CrcPerUsd.ToString("N6")</td>
                    <td>@exchangeRate.Source</td>
                    <td>@(exchangeRate.Notes ?? "—")</td>
                    @if (canManage)
                    {
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@exchangeRate.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_CatalogPagination" model="new CatalogPaginationViewModel(Model.Results.Page, Model.Results.TotalPages, Model.Results.HasPreviousPage, Model.Results.HasNextPage, Model.Search)" />

