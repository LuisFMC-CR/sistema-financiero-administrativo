<!DOCTYPE html>
@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool mustChangePassword = isAuthenticated && User.FindAll(SystemClaimTypes.MustChangePassword)
        .Any(claim => bool.TryParse(claim.Value, out bool required) && required);
    bool canViewCatalogs = isAuthenticated && !mustChangePassword &&
        (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ViewBusinessCatalogs)).Succeeded;
    bool canManageUsers = isAuthenticated && !mustChangePassword &&
        (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ManageUsers)).Succeeded;
}
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Financiero</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaFinanciero.Web.styles.css" asp-append-version="true" />
</head>
<body>
@if (isAuthenticated)
{
    <div class="app-layout" id="app-layout">
        <aside class="app-sidebar" id="app-sidebar" aria-label="Navegación principal">
            <div class="sidebar-brand">
                <a asp-controller="Home" asp-action="Index" class="sidebar-brand-link">
                    <span class="brand-mark" aria-hidden="true">SF</span>
                    <span class="sidebar-label">Sistema Financiero</span>
                </a>
                <button class="sidebar-toggle" type="button" aria-label="Contraer menú" aria-expanded="true" aria-controls="app-sidebar" data-sidebar-toggle>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
                </button>
            </div>
            <nav class="sidebar-nav">
                <a class="sidebar-link" asp-controller="Home" asp-action="Index" title="Inicio">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg><span class="sidebar-label">Inicio</span>
                </a>
                @if (canViewCatalogs)
                {
                    <p class="sidebar-heading sidebar-label">Catálogos</p>
                    <a class="sidebar-link" asp-controller="Customers" asp-action="Index" title="Clientes"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg><span class="sidebar-label">Clientes</span></a>
                    <a class="sidebar-link" asp-controller="Suppliers" asp-action="Index" title="Proveedores"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18M5 21V6l7-3 7 3v15M8 9h1m6 0h1m-8 4h1m6 0h1" /></svg><span class="sidebar-label">Proveedores</span></a>
                    <a class="sidebar-link" asp-controller="CatalogItems" asp-action="Index" title="Productos y servicios"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 8-9 5-9-5 9-5zM3 8v8l9 5 9-5V8" /></svg><span class="sidebar-label">Productos y servicios</span></a>
                    <a class="sidebar-link" asp-controller="FinancialCategories" asp-action="Index" title="Categorías financieras"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zm10 0h6v6h-6zM9 14h6v6H9zM7 10v2h10v-2m-5 2v2" /></svg><span class="sidebar-label">Categorías financieras</span></a>
                    <a class="sidebar-link" asp-controller="FinancialAccounts" asp-action="Index" title="Cuentas financieras"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="2" /><path d="M3 10h18m-5 5h2" /></svg><span class="sidebar-label">Cuentas financieras</span></a>
                    <a class="sidebar-link" asp-controller="ExchangeRates" asp-action="Index" title="Tipos de cambio"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v18m10-18v18M4 7h10a3 3 0 0 1 0 6H10a3 3 0 0 0 0 6h10" /></svg><span class="sidebar-label">Tipos de cambio</span></a>
                }
                @if (canManageUsers)
                {
                    <p class="sidebar-heading sidebar-label">Administración</p>
                    <a class="sidebar-link" asp-controller="Users" asp-action="Index" title="Usuarios"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="3" /><path d="M5 21v-2a7 7 0 0 1 14 0v2M4 9H2m20 0h-2" /></svg><span class="sidebar-label">Usuarios</span></a>
                }
            </nav>
        </aside>
        <div class="app-content-shell">
            <header class="app-topbar">
                <button class="mobile-sidebar-toggle" type="button" aria-label="Abrir menú" data-sidebar-toggle><span></span><span></span><span></span></button>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <a class="topbar-account" asp-controller="Account" asp-action="ChangePassword">@User.Identity?.Name</a>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="btn btn-sm btn-outline-primary">Cerrar sesión</button></form>
                </div>
            </header>
            <main role="main" class="app-main"><partial name="_FlashMessages" />@RenderBody()</main>
            <footer class="app-footer">&copy; 2026 - Sistema web de control financiero-administrativo</footer>
        </div>
    </div>
}
else
{
    <main role="main" class="container py-4"><partial name="_FlashMessages" />@RenderBody()</main>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
