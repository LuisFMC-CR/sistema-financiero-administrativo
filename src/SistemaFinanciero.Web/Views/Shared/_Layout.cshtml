<!DOCTYPE html>
@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool mustChangePassword = isAuthenticated && User.FindAll(SystemClaimTypes.MustChangePassword)
        .Any(claim => bool.TryParse(claim.Value, out bool required) && required);
    bool canViewCatalogs = isAuthenticated && !mustChangePassword &&
        (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ViewBusinessCatalogs)).Succeeded;
    bool canViewFinancialCatalogs = canViewCatalogs && !User.IsInRole(SystemRoles.Assistant);
    bool canViewInvoices = isAuthenticated && !mustChangePassword &&
        (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ViewFinancialTransactions)).Succeeded;
    bool canViewReceivablesAndPayables = isAuthenticated && !mustChangePassword &&
        (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ViewReceivablesAndPayables)).Succeeded;
    bool canManageUsers = isAuthenticated && !mustChangePassword &&
        (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ManageUsers)).Succeeded;
    bool canViewFinancialReports = isAuthenticated && !mustChangePassword &&
        (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ViewFinancialReports)).Succeeded;
    bool canRegisterCreditNotes = isAuthenticated && !mustChangePassword &&
        (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ConfirmFinancialTransactions)).Succeeded;
    bool canViewAuditTrail = isAuthenticated && !mustChangePassword &&
        (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ViewAuditTrail)).Succeeded;
    bool canManageSystemParameters = isAuthenticated && !mustChangePassword &&
        (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ManageSystemParameters)).Succeeded;
    string sidebarBrandLabel = (isAuthenticated ? User.FindFirst(SystemClaimTypes.FullName)?.Value : null)
        ?? "Sistema Financiero Contable";
}
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Financiero Contable</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaFinanciero.Web.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/logo.png" />
</head>
<body>
@if (isAuthenticated)
{
    <div class="app-layout" id="app-layout">
        <aside class="app-sidebar" id="app-sidebar" aria-label="Navegación principal">
            <div class="sidebar-brand">
                <a asp-controller="Home" asp-action="Index" class="sidebar-brand-link">
                    <img src="~/logo.png" alt="" class="brand-mark" aria-hidden="true" />
                    <span class="sidebar-label">@sidebarBrandLabel</span>
                </a>
                <button class="sidebar-toggle" type="button" aria-label="Contraer menú" aria-expanded="true" aria-controls="app-sidebar" data-sidebar-toggle>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
                </button>
            </div>
            <nav class="sidebar-nav">
                <a class="sidebar-link" asp-controller="Home" asp-action="Index" title="Dashboard">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg><span class="sidebar-label">Dashboard</span>
                </a>
                @if (canViewInvoices || canViewReceivablesAndPayables)
                {
                    <p class="sidebar-heading sidebar-label">Ciclo Operativo Diario</p>
                    @if (canViewInvoices)
                    {
                        <a class="sidebar-link" asp-controller="Invoices" asp-action="Index" title="Facturas"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10v18l-2.5-1.5L12 21l-2.5-1.5L7 21zM9 8h6M9 12h6M9 16h3" /></svg><span class="sidebar-label">Facturas</span></a>
                    }
                    @if (canViewReceivablesAndPayables)
                    {
                        <a class="sidebar-link" asp-controller="Receivables" asp-action="Index" title="Cuentas por cobrar"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10h18M3 6h18v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zM7 14h4" /></svg><span class="sidebar-label">Cuentas por cobrar</span></a>
                    }
                    @if (canViewInvoices)
                    {
                        <a class="sidebar-link" asp-controller="Incomes" asp-action="Index" title="Ingresos"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14" /></svg><span class="sidebar-label">Ingresos</span></a>
                    }
                    @if (canRegisterCreditNotes)
                    {
                        <a class="sidebar-link" asp-controller="CreditNotes" asp-action="Index" title="Notas de crédito"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10v18l-2.5-1.5L12 21l-2.5-1.5L7 21zM9 8h6M9 12h6M9 16h3M5 12H2m0 0 2-2m-2 2 2 2" /></svg><span class="sidebar-label">Notas de crédito</span></a>
                    }
                    @if (canViewInvoices)
                    {
                        <a class="sidebar-link" asp-controller="Expenses" asp-action="Index" title="Gastos"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10v18l-2.5-1.5L12 21l-2.5-1.5L7 21zM9 8h6M9 12h6M9 16h3" /></svg><span class="sidebar-label">Gastos</span></a>
                    }
                    @if (canViewReceivablesAndPayables)
                    {
                        <a class="sidebar-link" asp-controller="Payables" asp-action="Index" title="Cuentas por pagar"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10h18M3 6h18v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zM7 14h4" /></svg><span class="sidebar-label">Cuentas por pagar</span></a>
                    }
                }
                @if (canViewFinancialReports)
                {
                    <p class="sidebar-heading sidebar-label">Control Financiero Contable</p>
                    <a class="sidebar-link" asp-controller="Budgets" asp-action="Index" title="Presupuesto"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5a1 1 0 0 1 1-1h11l4 4v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM16 4v4h4M8 13h8M8 17h5" /></svg><span class="sidebar-label">Presupuesto</span></a>
                    <a class="sidebar-link" asp-controller="JournalEntries" asp-action="Index" title="Asientos contables"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5a1 1 0 0 1 1-1h11l4 4v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM16 4v4h4M8 13h3m2 0h3M8 17h3m2 0h3" /></svg><span class="sidebar-label">Asientos contables</span></a>
                    <a class="sidebar-link" asp-controller="Reports" asp-action="Index" title="Reportes"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5a1 1 0 0 1 1-1h11l4 4v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM16 4v4h4M8 11h8v6H8z" /></svg><span class="sidebar-label">Reportes</span></a>
                    @if (canViewAuditTrail)
                    {
                        <a class="sidebar-link" asp-controller="OperationAudit" asp-action="Index" title="Bitácora de operaciones"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5a1 1 0 0 1 1-1h11l4 4v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM16 4v4h4M8 11h3m-3 4h8m-8 4h5" /></svg><span class="sidebar-label">Bitácora de operaciones</span></a>
                    }
                }
                @if (canViewCatalogs)
                {
                    <p class="sidebar-heading sidebar-label">Catálogos</p>
                    <a class="sidebar-link" asp-controller="Customers" asp-action="Index" title="Clientes"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg><span class="sidebar-label">Clientes</span></a>
                    <a class="sidebar-link" asp-controller="Suppliers" asp-action="Index" title="Proveedores"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18M5 21V6l7-3 7 3v15M8 9h1m6 0h1m-8 4h1m6 0h1" /></svg><span class="sidebar-label">Proveedores</span></a>
                    <a class="sidebar-link" asp-controller="CatalogItems" asp-action="Index" title="Productos y servicios"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 8-9 5-9-5 9-5zM3 8v8l9 5 9-5V8" /></svg><span class="sidebar-label">Productos y servicios</span></a>
                    @if (canViewFinancialCatalogs)
                    {
                        <a class="sidebar-link" asp-controller="LedgerAccounts" asp-action="Index" title="Catálogo contable"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h16M8 5v14" /></svg><span class="sidebar-label">Catálogo contable</span></a>
                        <a class="sidebar-link" asp-controller="CashTransfers" asp-action="Index" title="Traspasos"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h13m0 0-4-4m4 4-4 4M17 17H4m0 0 4 4m-4-4 4-4" /></svg><span class="sidebar-label">Traspasos</span></a>
                        <a class="sidebar-link" asp-controller="TaxesAndWithholdings" asp-action="Index" title="Impuestos y retenciones"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M7.5 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm9 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" /></svg><span class="sidebar-label">Impuestos y retenciones</span></a>
                        <a class="sidebar-link" asp-controller="VatSettlements" asp-action="Index" title="Liquidación de IVA"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5a1 1 0 0 1 1-1h11l4 4v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM16 4v4h4M8 13h3m5-2-3 6m0-6 3 6" /></svg><span class="sidebar-label">Liquidación de IVA</span></a>
                        <a class="sidebar-link" asp-controller="IncomeTaxPayments" asp-action="Index" title="Pagos de renta"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="1" /><circle cx="12" cy="12" r="2.5" /><path d="M6 9v.01M18 15v.01" /></svg><span class="sidebar-label">Pagos de renta</span></a>
                    }
                }
                @if (canManageSystemParameters)
                {
                    <p class="sidebar-heading sidebar-label">Configuración</p>
                    <a class="sidebar-link" asp-controller="SystemParameters" asp-action="Index" title="Parámetros del sistema"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v3m0 12v3m9-9h-3M6 12H3m14.5-6.5-2.1 2.1M8.6 15.4l-2.1 2.1m11-2.1 2.1 2.1M8.6 8.6 6.5 6.5" /><circle cx="12" cy="12" r="3" /></svg><span class="sidebar-label">Parámetros del sistema</span></a>
                }
                @if (canManageUsers)
                {
                    <p class="sidebar-heading sidebar-label">Administración</p>
                    <a class="sidebar-link" asp-controller="Users" asp-action="Index" title="Usuarios"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="3" /><path d="M5 21v-2a7 7 0 0 1 14 0v2M4 9H2m20 0h-2" /></svg><span class="sidebar-label">Usuarios</span></a>
                    <a class="sidebar-link" asp-controller="SecurityAudit" asp-action="Index" title="Bitácora de seguridad"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" /></svg><span class="sidebar-label">Bitácora de seguridad</span></a>
                }
            </nav>
        </aside>
        <div class="app-content-shell">
            <header class="app-topbar">
                <button class="mobile-sidebar-toggle" type="button" aria-label="Abrir menú" data-sidebar-toggle><span></span><span></span><span></span></button>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <a class="topbar-account" asp-controller="Account" asp-action="ChangePassword">@User.Identity?.Name</a>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="btn btn-sm btn-outline-primary">Cerrar sesión</button></form>
                </div>
            </header>
            <main role="main" class="app-main"><partial name="_FlashMessages" />@RenderBody()</main>
            <footer class="app-footer">&copy; 2026 - Sistema web de control financiero-administrativo</footer>
        </div>
    </div>
}
else if (ViewData["FullBleed"] as bool? == true)
{
    bool hasFlashMessage = TempData.Peek("SuccessMessage") is string || TempData.Peek("ErrorMessage") is string;
    <main role="main">
        @if (hasFlashMessage)
        {
            <div class="container pt-3"><partial name="_FlashMessages" /></div>
        }
        @RenderBody()
    </main>
}
else
{
    <main role="main" class="container py-4"><partial name="_FlashMessages" />@RenderBody()</main>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
