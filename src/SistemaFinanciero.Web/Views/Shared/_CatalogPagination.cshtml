@model CatalogPaginationViewModel

@if (Model.TotalPages > 1)
{
    <nav aria-label="Paginación del catálogo" class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <span class="text-body-secondary">Página @Model.CurrentPage de @Model.TotalPages</span>
        <ul class="pagination mb-0">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : null)">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   aria-disabled="@(!Model.HasPreviousPage)">Anterior</a>
            </li>
            <li class="page-item @(!Model.HasNextPage ? "disabled" : null)">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   aria-disabled="@(!Model.HasNextPage)">Siguiente</a>
            </li>
        </ul>
    </nav>
}

