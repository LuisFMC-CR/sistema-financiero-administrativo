@model SupplierInputViewModel

<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="row g-3">
    @if (Model is SupplierEditViewModel editModel)
    {
        <div class="col-md-4">
            <label class="form-label">Código</label>
            <input type="text" class="form-control" value="@editModel.Code" disabled readonly />
        </div>
        <div class="col-md-8">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autocomplete="organization" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    }
    else
    {
        <div class="col-md-12">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autocomplete="organization" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    }
    <div class="col-md-4">
        <label asp-for="Identification" class="form-label"></label>
        <input asp-for="Identification" class="form-control" autocomplete="off" />
        <span asp-validation-for="Identification" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" autocomplete="tel" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="EconomicActivity" class="form-label"></label>
        <input asp-for="EconomicActivity" class="form-control" autocomplete="off" />
        <span asp-validation-for="EconomicActivity" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control" rows="3" autocomplete="street-address"></textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
</div>

