@using SistemaFinanciero.Application.Incomes
@using SistemaFinanciero.Application.Security
@using SistemaFinanciero.Domain.Incomes
@using SistemaFinanciero.Web.Models.Incomes
@using SistemaFinanciero.Web.Models.Invoices
@model IncomeIndexViewModel
@{
    ViewData["Title"] = "Ingresos";
    bool canCreate = (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.RegisterManualIncome)).Succeeded;
    bool canRegisterReceivablePayment = (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.RegisterReceivablePayments)).Succeeded;
    bool canCancel = (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.VoidFinancialTransactions)).Succeeded;
    int columnCount = canCancel ? 8 : 7;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="h2 mb-1">Ingresos</h1>
        <p class="text-body-secondary mb-0">Automáticos (factura de contado, abono) y manuales.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (canCreate)
        {
            <a asp-action="Create" class="btn btn-primary">Nuevo ingreso manual</a>
        }
        @if (canRegisterReceivablePayment)
        {
            <a asp-controller="ReceivablePayments" asp-action="Start" class="btn btn-outline-primary">
                Distribuir un cobro entre cuentas por cobrar
            </a>
        }
    </div>
</div>

<form method="get" role="search">
<div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">Fecha</th>
                <th scope="col">Origen</th>
                <th scope="col">Categoría</th>
                <th scope="col">Cuenta de efectivo</th>
                <th scope="col">Referencia / descripción</th>
                <th scope="col" class="text-end">Monto</th>
                <th scope="col">Estado</th>
                @if (canCancel)
                {
                    <th scope="col" class="text-end">Acciones</th>
                }
            </tr>
            <tr class="table-filter-row">
                <th class="p-2">
                    <div class="d-flex gap-1">
                        <input name="incomeDateFrom" type="date" value="@Model.Query.IncomeDateFrom?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="Fecha desde" />
                        <input name="incomeDateTo" type="date" value="@Model.Query.IncomeDateTo?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="Fecha hasta" />
                    </div>
                </th>
                <th class="p-2">
                    <select name="origin" class="form-select form-select-sm" aria-label="Filtrar por origen">
                        @foreach (IncomeOriginFilter origin in Enum.GetValues<IncomeOriginFilter>())
                        {
                            if (origin == Model.Query.Origin)
                            {
                                <option value="@origin" selected>@origin.ToDisplayName()</option>
                            }
                            else
                            {
                                <option value="@origin">@origin.ToDisplayName()</option>
                            }
                        }
                    </select>
                </th>
                <th class="p-2">
                    <input name="accountName" value="@Model.Query.AccountName" class="form-control form-control-sm" placeholder="Categoría" aria-label="Filtrar por categoría" />
                </th>
                <th class="p-2">
                    <input name="cashAccountName" value="@Model.Query.CashAccountName" class="form-control form-control-sm" placeholder="Cuenta" aria-label="Filtrar por cuenta de efectivo" />
                </th>
                <th class="p-2">
                    <input name="referenceOrDescription" value="@Model.Query.ReferenceOrDescription" class="form-control form-control-sm" placeholder="Referencia o descripción" aria-label="Filtrar por referencia o descripción" />
                </th>
                <th class="p-2">
                    <div class="d-flex gap-1">
                        <input name="amountMin" type="number" step="0.01" value="@Model.Query.AmountMin?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm" placeholder="Mín" aria-label="Monto mínimo" />
                        <input name="amountMax" type="number" step="0.01" value="@Model.Query.AmountMax?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm" placeholder="Máx" aria-label="Monto máximo" />
                    </div>
                </th>
                <th class="p-2">
                    <select name="status" class="form-select form-select-sm" aria-label="Filtrar por estado">
                        @foreach (IncomeStatusFilter status in Enum.GetValues<IncomeStatusFilter>())
                        {
                            if (status == Model.Query.Status)
                            {
                                <option value="@status" selected>@status.ToDisplayName()</option>
                            }
                            else
                            {
                                <option value="@status">@status.ToDisplayName()</option>
                            }
                        }
                    </select>
                </th>
                @if (canCancel)
                {
                    <th class="p-2"></th>
                }
            </tr>
            <tr>
                <th colspan="@columnCount" class="p-2 text-end">
                    <button type="submit" class="btn btn-sm btn-primary" aria-label="Buscar ingresos" title="Buscar">
                        <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5" /><path d="m10.5 10.5 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary" aria-label="Limpiar filtros" title="Limpiar">
                        <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 4h10M6 4V2.5h4V4m2 0-.6 9H4.6L4 4m2.5 2v4.5m3-4.5v4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </a>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Results.Items.Count == 0)
            {
                <tr><td colspan="@columnCount" class="text-center text-body-secondary py-4">No se encontraron ingresos.</td></tr>
            }
            @foreach (IncomeModel income in Model.Results.Items)
            {
                <tr>
                    <td class="fw-semibold">
                        <a asp-action="Details" asp-route-id="@income.Id">@income.IncomeDate.ToString("dd/MM/yyyy")</a>
                        <br /><small class="text-body-secondary">@income.Code</small>
                    </td>
                    <td>
                        @income.Origin.ToDisplayName()
                        @if (income.Origin == IncomeOrigin.InvoiceCash && income.InvoiceNumber is not null)
                        {
                            <br /><small class="text-body-secondary">Factura @income.InvoiceNumber</small>
                        }
                    </td>
                    <td>@income.AccountName</td>
                    <td>@income.CashAccountName</td>
                    <td>
                        @(income.Reference ?? "—")
                        @if (!string.IsNullOrWhiteSpace(income.Description))
                        {
                            <br /><small class="text-body-secondary">@income.Description</small>
                        }
                    </td>
                    <td class="text-end">₡@income.Amount.ToString("N2")</td>
                    <td>
                        @income.Status.ToDisplayName()
                        @if (income.Status == IncomeStatus.Cancelled && !string.IsNullOrWhiteSpace(income.CancellationReason))
                        {
                            <br /><small class="text-body-secondary">@income.CancellationReason</small>
                        }
                    </td>
                    @if (canCancel)
                    {
                        <td class="text-end">
                            @if (income.Origin == IncomeOrigin.Manual && income.Status == IncomeStatus.Active)
                            {
                                <a asp-action="Cancel" asp-route-id="@income.Id" class="btn btn-sm btn-outline-danger">Anular</a>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
</form>

<partial name="_Pagination" model="Model" />
