@using SistemaFinanciero.Domain.Common
@using SistemaFinanciero.Web.Models.Incomes
@using SistemaFinanciero.Web.Models.Invoices
@model CreateManualIncomeViewModel
@{
    ViewData["Title"] = "Nuevo ingreso manual";
}

<div class="catalog-form">
    <h1 class="h2">Nuevo ingreso manual</h1>
    <p class="text-body-secondary">
        Otras entradas de la operación: reintegros o intereses que acredite el banco. Nunca préstamos
        ni aportes (regla 2).
    </p>
    <form method="post" class="card card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                    <option value="">Seleccione una categoría</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CashAccountId" class="form-label"></label>
                <select asp-for="CashAccountId" asp-items="Model.CashAccountOptions" class="form-select">
                    <option value="">Seleccione una cuenta de efectivo</option>
                </select>
                <span asp-validation-for="CashAccountId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="IncomeDate" class="form-label"></label>
                <input asp-for="IncomeDate" type="date" class="form-control" />
                <span asp-validation-for="IncomeDate" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="PaymentMethod" class="form-label"></label>
                <select asp-for="PaymentMethod" class="form-select">
                    @foreach (PaymentMethod method in Enum.GetValues<PaymentMethod>())
                    {
                        <option value="@method">@method.ToDisplayName()</option>
                    }
                </select>
                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Reference" class="form-label"></label>
                <input asp-for="Reference" class="form-control" />
                <span asp-validation-for="Reference" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2" placeholder="Explique de qué se trata, por ejemplo: reintegro de un proveedor por un pago duplicado."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">Registrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
