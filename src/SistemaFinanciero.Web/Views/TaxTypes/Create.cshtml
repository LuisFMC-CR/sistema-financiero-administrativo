@model TaxTypeCreateViewModel
@{
    ViewData["Title"] = "Nuevo tipo de impuesto";
}

<div class="catalog-form">
    <h1 class="h2">Nuevo tipo de impuesto</h1>
    <p class="text-body-secondary">Los precios se registran sin IVA; la tarifa se calcula sobre el monto neto de cada línea.</p>
    <form asp-action="Create" method="post" class="card card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control text-uppercase" autocomplete="off" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Rate" class="form-label"></label>
                <input asp-for="Rate" type="number" min="0" step="0.0001" class="form-control" />
                <span asp-validation-for="Rate" class="text-danger"></span>
                <div class="form-text">Porcentaje de 0 a 100.</div>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar tipo de impuesto</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
