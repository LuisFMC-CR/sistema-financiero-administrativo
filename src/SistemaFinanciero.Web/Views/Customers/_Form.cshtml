@model CustomerInputViewModel

<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="row g-3">
    @if (Model is CustomerEditViewModel editModel)
    {
        <div class="col-md-4">
            <label class="form-label">Código</label>
            <input type="text" class="form-control" value="@editModel.Code" disabled readonly />
        </div>
        <div class="col-md-8">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autocomplete="organization" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    }
    else
    {
        <div class="col-md-12">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autocomplete="organization" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    }
    <div class="col-md-4">
        <label asp-for="IdentificationType" class="form-label"></label>
        <select asp-for="IdentificationType" class="form-select">
            @foreach (IdentificationType type in Enum.GetValues<IdentificationType>())
            {
                <option value="@type">@type.ToDisplayName()</option>
            }
        </select>
        <span asp-validation-for="IdentificationType" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Identification" class="form-label"></label>
        <input asp-for="Identification" class="form-control" autocomplete="off" />
        <span asp-validation-for="Identification" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" autocomplete="tel" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control" rows="3" autocomplete="street-address"></textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="CreditLimit" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">₡</span>
            <input asp-for="CreditLimit" type="number" min="0" step="0.01" class="form-control" />
        </div>
        <span asp-validation-for="CreditLimit" class="text-danger"></span>
        <div class="form-text">Opcional. Si se deja en blanco, el cliente no tiene límite configurado.</div>
    </div>
    <div class="col-md-4">
        <label asp-for="VatCondition" class="form-label"></label>
        <select asp-for="VatCondition" class="form-select">
            @foreach (VatCondition condition in Enum.GetValues<VatCondition>())
            {
                <option value="@condition">@condition.ToDisplayName()</option>
            }
        </select>
        <span asp-validation-for="VatCondition" class="text-danger"></span>
        <div class="form-text">Determina automáticamente la tarifa de IVA de cada línea de sus facturas.</div>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check">
            <input asp-for="AppliesStateWithholding" class="form-check-input" />
            <label asp-for="AppliesStateWithholding" class="form-check-label"></label>
        </div>
    </div>
</div>

