@using SistemaFinanciero.Application.Reports
@using SistemaFinanciero.Web.Models.Reports
@model LedgerBookReportViewModel
@{
    ViewData["Title"] = "Libro mayor";
    LedgerBookReportResult? result = Model.Result;
}

<h1 class="h2 mb-1">Libro mayor</h1>
<p class="text-body-secondary mb-3">Movimientos y saldo acumulado de una cuenta contable, en un rango de fechas (RF-81).</p>

<form method="get" asp-action="LedgerBook" class="row gy-2 gx-3 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-0" for="accountId">Cuenta</label>
        <select class="form-select form-select-sm" id="accountId" name="accountId" asp-items="Model.AccountOptions" required>
            <option value="">Seleccione una cuenta…</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="periodFrom">Desde</label>
        <input class="form-control form-control-sm" type="date" id="periodFrom" name="periodFrom" value="@Model.PeriodFrom.ToString("yyyy-MM-dd")" required />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="periodTo">Hasta</label>
        <input class="form-control form-control-sm" type="date" id="periodTo" name="periodTo" value="@Model.PeriodTo.ToString("yyyy-MM-dd")" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Consultar</button>
    </div>
    @if (result is not null)
    {
        <div class="col-auto">
            <a class="btn btn-outline-secondary btn-sm" asp-action="LedgerBookPdf" asp-route-accountId="@Model.AccountId" asp-route-periodFrom="@Model.PeriodFrom.ToString("yyyy-MM-dd")" asp-route-periodTo="@Model.PeriodTo.ToString("yyyy-MM-dd")">Exportar PDF</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="LedgerBookExcel" asp-route-accountId="@Model.AccountId" asp-route-periodFrom="@Model.PeriodFrom.ToString("yyyy-MM-dd")" asp-route-periodTo="@Model.PeriodTo.ToString("yyyy-MM-dd")">Exportar Excel</a>
        </div>
    }
</form>

@if (result is not null)
{
    <p class="fw-semibold">Cuenta @result.AccountCode — @result.AccountName</p>
    <p>Saldo anterior: ₡@result.OpeningBalance.ToString("N2")</p>

    <div class="table-responsive bg-white border rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Fecha</th>
                    <th scope="col">Asiento</th>
                    <th scope="col">Descripción</th>
                    <th scope="col" class="text-end">Débito</th>
                    <th scope="col" class="text-end">Crédito</th>
                    <th scope="col" class="text-end">Saldo</th>
                </tr>
            </thead>
            <tbody>
                @if (result.Movements.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-body-secondary py-4">Esta cuenta no tiene movimientos en el período.</td></tr>
                }
                @foreach (LedgerBookMovement movement in result.Movements)
                {
                    <tr>
                        <td>@movement.EntryDate.ToString("dd/MM/yyyy")</td>
                        <td>@movement.JournalEntryNumber</td>
                        <td>@movement.Description</td>
                        <td class="text-end">@(movement.Debit > 0 ? $"₡{movement.Debit:N2}" : "—")</td>
                        <td class="text-end">@(movement.Credit > 0 ? $"₡{movement.Credit:N2}" : "—")</td>
                        <td class="text-end">₡@movement.RunningBalance.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="text-end fw-semibold mt-2">Saldo final: ₡@result.ClosingBalance.ToString("N2")</p>
    <p class="text-body-secondary"><small>Saldos calculados a partir de las operaciones registradas en el sistema; no incluye saldos iniciales.</small></p>
}
