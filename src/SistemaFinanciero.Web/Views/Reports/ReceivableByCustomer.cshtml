@using SistemaFinanciero.Application.Reports
@using SistemaFinanciero.Web.Models.Reports
@model ReceivableByCustomerReportViewModel
@{
    ViewData["Title"] = "Cuentas por cobrar por cliente";
    ReceivableByCustomerReportResult result = Model.Result;
}

<h1 class="h2 mb-1">Cuentas por cobrar por cliente</h1>
<p class="text-body-secondary mb-3">Cuentas por cobrar vigentes a la fecha, agrupadas por cliente, con antigüedad de saldos. Haga clic en un cliente para ver el desglose por cuenta.</p>

<div class="d-flex justify-content-end gap-2 mb-3">
    @if (result.Lines.Count > 0)
    {
        <a class="btn btn-outline-secondary btn-sm" asp-action="ReceivableByCustomerPdf">Exportar PDF</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="ReceivableByCustomerExcel">Exportar Excel</a>
    }
</div>

<div class="bg-white border rounded">
    @if (result.Lines.Count == 0)
    {
        <p class="text-center text-body-secondary py-4 mb-0">No hay cuentas por cobrar vigentes.</p>
    }
    else
    {
        @foreach (ReceivableByCustomerReportLine line in result.Lines)
        {
            <details class="aging-entry">
                <summary class="d-flex flex-wrap justify-content-between align-items-start gap-3 px-3 py-3">
                    <div>
                        <div class="fw-semibold">@line.CustomerName</div>
                        <div class="text-body-secondary small">
                            @line.ReceivableCount cuenta(s) · vence más próximo @line.EarliestDueDate.ToString("dd/MM/yyyy")
                        </div>
                        <div class="text-body-secondary small">
                            Al día ₡@line.Aging.Current.ToString("N2") ·
                            1-30 ₡@line.Aging.Overdue1To30.ToString("N2") ·
                            31-60 ₡@line.Aging.Overdue31To60.ToString("N2") ·
                            61-90 ₡@line.Aging.Overdue61To90.ToString("N2") ·
                            +90 ₡@line.Aging.OverdueOver90.ToString("N2")
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="fw-semibold">₡@line.TotalBalance.ToString("N2")</div>
                        <div class="text-body-secondary small">Saldo total</div>
                    </div>
                </summary>
                <div class="px-3 pb-3">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Factura</th>
                                    <th scope="col" class="text-end">Emisión</th>
                                    <th scope="col" class="text-end">Vencimiento</th>
                                    <th scope="col" class="text-end">Saldo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (ReceivableDetailLine detail in line.Details)
                                {
                                    <tr>
                                        <td>@(detail.InvoiceNumber is long number ? $"Factura N° {number}" : "—")</td>
                                        <td class="text-end">@detail.IssueDate.ToString("dd/MM/yyyy")</td>
                                        <td class="text-end">@detail.DueDate.ToString("dd/MM/yyyy")</td>
                                        <td class="text-end">₡@detail.Balance.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </details>
        }
    }
</div>

@if (result.Lines.Count > 0)
{
    <div class="d-flex justify-content-end gap-4 mt-3 pe-2">
        <span class="text-body-secondary small">Al día: ₡@result.GrandTotalAging.Current.ToString("N2")</span>
        <span class="text-body-secondary small">1-30 días: ₡@result.GrandTotalAging.Overdue1To30.ToString("N2")</span>
        <span class="text-body-secondary small">31-60 días: ₡@result.GrandTotalAging.Overdue31To60.ToString("N2")</span>
        <span class="text-body-secondary small">61-90 días: ₡@result.GrandTotalAging.Overdue61To90.ToString("N2")</span>
        <span class="text-body-secondary small">Más de 90 días: ₡@result.GrandTotalAging.OverdueOver90.ToString("N2")</span>
        <span class="fw-semibold">Saldo total: ₡@result.GrandTotalBalance.ToString("N2")</span>
    </div>
}
