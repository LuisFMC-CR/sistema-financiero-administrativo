@using SistemaFinanciero.Application.Reports
@using SistemaFinanciero.Web.Models.Reports
@model TrialBalanceReportViewModel
@{
    ViewData["Title"] = "Balanza de comprobación";
    TrialBalanceReportResult result = Model.Result!;
}

<h1 class="h2 mb-1">Balanza de comprobación</h1>
<p class="text-body-secondary mb-3">Débitos, créditos y saldo de cada cuenta de detalle con movimiento, a una fecha de corte (RF-82).</p>

<form method="get" asp-action="TrialBalance" class="row gy-2 gx-3 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-0" for="cutoffDate">Fecha de corte</label>
        <input class="form-control form-control-sm" type="date" id="cutoffDate" name="cutoffDate" value="@Model.CutoffDate.ToString("yyyy-MM-dd")" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Consultar</button>
    </div>
    @if (result.Groups.Count > 0)
    {
        <div class="col-auto">
            <a class="btn btn-outline-secondary btn-sm" asp-action="TrialBalancePdf" asp-route-cutoffDate="@Model.CutoffDate.ToString("yyyy-MM-dd")">Exportar PDF</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="TrialBalanceExcel" asp-route-cutoffDate="@Model.CutoffDate.ToString("yyyy-MM-dd")">Exportar Excel</a>
        </div>
    }
</form>

@if (result.Groups.Count == 0)
{
    <p class="text-body-secondary text-center py-4">No hay cuentas con movimiento hasta la fecha de corte indicada.</p>
}
else
{
    <div class="table-responsive bg-white border rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Cuenta</th>
                    <th scope="col" class="text-end">Débitos</th>
                    <th scope="col" class="text-end">Créditos</th>
                    <th scope="col" class="text-end">Saldo deudor</th>
                    <th scope="col" class="text-end">Saldo acreedor</th>
                </tr>
            </thead>
            <tbody>
                @foreach (TrialBalanceGroupLine group in result.Groups)
                {
                    @foreach (TrialBalanceAccountLine account in group.Accounts)
                    {
                        <tr>
                            <td>@account.AccountCode</td>
                            <td>@account.AccountName</td>
                            <td class="text-end">₡@account.TotalDebit.ToString("N2")</td>
                            <td class="text-end">₡@account.TotalCredit.ToString("N2")</td>
                            <td class="text-end">@(account.DebitBalance > 0 ? $"₡{account.DebitBalance:N2}" : "—")</td>
                            <td class="text-end">@(account.CreditBalance > 0 ? $"₡{account.CreditBalance:N2}" : "—")</td>
                        </tr>
                    }
                    <tr class="table-light fw-semibold">
                        <td colspan="2">Subtotal @group.GroupCode — @group.GroupName</td>
                        <td class="text-end">₡@group.TotalDebit.ToString("N2")</td>
                        <td class="text-end">₡@group.TotalCredit.ToString("N2")</td>
                        <td class="text-end">₡@group.DebitBalance.ToString("N2")</td>
                        <td class="text-end">₡@group.CreditBalance.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-semibold">
                    <td colspan="2">Total</td>
                    <td class="text-end">₡@result.GrandTotalDebit.ToString("N2")</td>
                    <td class="text-end">₡@result.GrandTotalCredit.ToString("N2")</td>
                    <td class="text-end">₡@result.GrandTotalDebitBalance.ToString("N2")</td>
                    <td class="text-end">₡@result.GrandTotalCreditBalance.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <p class="text-body-secondary mt-2"><small>Saldos calculados a partir de las operaciones registradas en el sistema; no incluye saldos iniciales.</small></p>
}
