@using System.Globalization
@using SistemaFinanciero.Application.Reports
@using SistemaFinanciero.Web.Models.Reports
@model MonthlyComparisonReportViewModel
@{
    ViewData["Title"] = "Comparativo mensual de ingresos y gastos";
    CultureInfo culture = CultureInfo.GetCultureInfo("es-CR");
}

<h1 class="h2 mb-1">Comparativo mensual de ingresos y gastos</h1>
<p class="text-body-secondary mb-3">Un rango de meses, lado a lado (regla de negocio 8).</p>

<form method="get" asp-action="MonthlyComparison" class="row gy-2 gx-3 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-0" for="periodYearFrom">Desde (año)</label>
        <input class="form-control form-control-sm" type="number" id="periodYearFrom" name="periodYearFrom" value="@Model.PeriodYearFrom" required />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="periodMonthFrom">Desde (mes)</label>
        <input class="form-control form-control-sm" type="number" min="1" max="12" id="periodMonthFrom" name="periodMonthFrom" value="@Model.PeriodMonthFrom" required />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="periodYearTo">Hasta (año)</label>
        <input class="form-control form-control-sm" type="number" id="periodYearTo" name="periodYearTo" value="@Model.PeriodYearTo" required />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="periodMonthTo">Hasta (mes)</label>
        <input class="form-control form-control-sm" type="number" min="1" max="12" id="periodMonthTo" name="periodMonthTo" value="@Model.PeriodMonthTo" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Consultar</button>
    </div>
    @if (Model.Result is { } nonEmptyResult && (nonEmptyResult.GrandTotalIncome != 0 || nonEmptyResult.GrandTotalExpense != 0))
    {
        <div class="col-auto">
            <a class="btn btn-outline-secondary btn-sm" asp-action="MonthlyComparisonPdf" asp-route-periodYearFrom="@Model.PeriodYearFrom" asp-route-periodMonthFrom="@Model.PeriodMonthFrom" asp-route-periodYearTo="@Model.PeriodYearTo" asp-route-periodMonthTo="@Model.PeriodMonthTo">Exportar PDF</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="MonthlyComparisonExcel" asp-route-periodYearFrom="@Model.PeriodYearFrom" asp-route-periodMonthFrom="@Model.PeriodMonthFrom" asp-route-periodYearTo="@Model.PeriodYearTo" asp-route-periodMonthTo="@Model.PeriodMonthTo">Exportar Excel</a>
        </div>
    }
</form>

@if (Model.Result is MonthlyComparisonReportResult result)
{
    <div class="table-responsive bg-white border rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Mes</th>
                    <th scope="col" class="text-end">Ingresos</th>
                    <th scope="col" class="text-end">Gastos</th>
                </tr>
            </thead>
            <tbody>
                @if (result.GrandTotalIncome == 0 && result.GrandTotalExpense == 0)
                {
                    <tr><td colspan="3" class="text-center text-body-secondary py-4">No hay movimientos en el rango indicado.</td></tr>
                }
                else
                {
                    @foreach (MonthlyComparisonLine line in result.Lines)
                    {
                        <tr>
                            <td class="text-capitalize">@(new DateOnly(line.PeriodYear, line.PeriodMonth, 1).ToString("MMMM yyyy", culture))</td>
                            <td class="text-end">₡@line.TotalIncome.ToString("N2")</td>
                            <td class="text-end">₡@line.TotalExpense.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
            @if (result.GrandTotalIncome != 0 || result.GrandTotalExpense != 0)
            {
                <tfoot>
                    <tr class="fw-semibold">
                        <td class="text-end">Total</td>
                        <td class="text-end">₡@result.GrandTotalIncome.ToString("N2")</td>
                        <td class="text-end">₡@result.GrandTotalExpense.ToString("N2")</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
}
