@using SistemaFinanciero.Application.Reports
@using SistemaFinanciero.Web.Models.Reports
@model CustomerStatementReportViewModel
@{
    ViewData["Title"] = "Estado de cuenta de cliente";
}

<h1 class="h2 mb-1">Estado de cuenta de cliente</h1>
<p class="text-body-secondary mb-3">Historial de facturas a crédito y abonos, y saldo actual (regla de negocio 8).</p>

<form method="get" asp-action="CustomerStatement" class="row gy-2 gx-3 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-0" for="customerId">Cliente</label>
        <select class="form-select form-select-sm" id="customerId" name="customerId" asp-items="Model.CustomerOptions">
            <option value="">Seleccione un cliente</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Consultar</button>
    </div>
    @if (Model.Result is not null)
    {
        <div class="col-auto">
            <a class="btn btn-outline-secondary btn-sm" asp-action="CustomerStatementPdf" asp-route-customerId="@Model.CustomerId">Exportar PDF</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="CustomerStatementExcel" asp-route-customerId="@Model.CustomerId">Exportar Excel</a>
        </div>
    }
</form>

@if (Model.Result is CustomerStatementReportResult result)
{
    <div class="table-responsive bg-white border rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Fecha</th>
                    <th scope="col">Movimiento</th>
                    <th scope="col">Descripción</th>
                    <th scope="col" class="text-end">Monto</th>
                </tr>
            </thead>
            <tbody>
                @if (result.Lines.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-body-secondary py-4">Este cliente no tiene facturas a crédito.</td></tr>
                }
                @foreach (CustomerStatementLine line in result.Lines)
                {
                    <tr class="@(line.IsCancelled ? "text-body-secondary" : null)">
                        <td>@line.Date.ToString("dd/MM/yyyy")</td>
                        <td>@line.MovementType</td>
                        <td>@line.Description @(line.IsCancelled ? "(anulado)" : null)</td>
                        <td class="text-end">₡@line.Amount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            @if (result.Lines.Count > 0)
            {
                <tfoot>
                    <tr class="fw-semibold">
                        <td colspan="3" class="text-end">Saldo actual</td>
                        <td class="text-end">₡@result.CurrentBalance.ToString("N2")</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
}
