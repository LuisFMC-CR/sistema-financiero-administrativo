@using SistemaFinanciero.Application.Reports
@using SistemaFinanciero.Web.Models.Reports
@model IncomeStatementReportViewModel
@{
    ViewData["Title"] = "Estado de resultados";
    IncomeStatementReportResult result = Model.Result!;
}

<h1 class="h2 mb-1">Estado de resultados</h1>
<p class="text-body-secondary mb-3">Ingresos y gastos por cuenta en un rango de fechas, y la utilidad o pérdida del período (RF-83).</p>

<form method="get" asp-action="IncomeStatement" class="row gy-2 gx-3 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-0" for="periodFrom">Desde</label>
        <input class="form-control form-control-sm" type="date" id="periodFrom" name="periodFrom" value="@Model.PeriodFrom.ToString("yyyy-MM-dd")" required />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="periodTo">Hasta</label>
        <input class="form-control form-control-sm" type="date" id="periodTo" name="periodTo" value="@Model.PeriodTo.ToString("yyyy-MM-dd")" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Consultar</button>
    </div>
    @if (result.IncomeGroups.Count > 0 || result.ExpenseGroups.Count > 0)
    {
        <div class="col-auto">
            <a class="btn btn-outline-secondary btn-sm" asp-action="IncomeStatementPdf" asp-route-periodFrom="@Model.PeriodFrom.ToString("yyyy-MM-dd")" asp-route-periodTo="@Model.PeriodTo.ToString("yyyy-MM-dd")">Exportar PDF</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="IncomeStatementExcel" asp-route-periodFrom="@Model.PeriodFrom.ToString("yyyy-MM-dd")" asp-route-periodTo="@Model.PeriodTo.ToString("yyyy-MM-dd")">Exportar Excel</a>
        </div>
    }
</form>

@if (result.IncomeGroups.Count == 0 && result.ExpenseGroups.Count == 0)
{
    <p class="text-body-secondary text-center py-4">No hay movimientos de ingresos ni de gastos en el período indicado.</p>
}
else
{
    <h2 class="h5 mb-2">Ingresos</h2>
    <partial name="_IncomeStatementSection" model="result.IncomeGroups" />
    <p class="text-end fw-semibold mt-1">Total ingresos: ₡@result.TotalIncome.ToString("N2")</p>

    <h2 class="h5 mb-2 mt-4">Gastos</h2>
    <partial name="_IncomeStatementSection" model="result.ExpenseGroups" />
    <p class="text-end fw-semibold mt-1">Total gastos: ₡@result.TotalExpense.ToString("N2")</p>

    <hr class="mt-4" />
    <p class="text-end fs-5 fw-bold">
        @(result.NetResult >= 0 ? "Utilidad" : "Pérdida") del período: ₡@Math.Abs(result.NetResult).ToString("N2")
    </p>

    <p class="text-body-secondary"><small>Saldos calculados a partir de las operaciones registradas en el sistema; no incluye saldos iniciales.</small></p>
}
