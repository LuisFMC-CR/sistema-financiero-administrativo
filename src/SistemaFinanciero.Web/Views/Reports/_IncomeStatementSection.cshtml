@using SistemaFinanciero.Application.Reports
@model IReadOnlyList<IncomeStatementGroupLine>

<div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">Código</th>
                <th scope="col">Cuenta</th>
                <th scope="col" class="text-end">Monto</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="3" class="text-center text-body-secondary py-3">Sin movimientos en el período.</td></tr>
            }
            @foreach (IncomeStatementGroupLine group in Model)
            {
                @foreach (IncomeStatementAccountLine account in group.Accounts)
                {
                    <tr>
                        <td>@account.AccountCode</td>
                        <td>@account.AccountName</td>
                        <td class="text-end">₡@account.Amount.ToString("N2")</td>
                    </tr>
                }
                <tr class="table-light fw-semibold">
                    <td colspan="2">Subtotal @group.GroupCode — @group.GroupName</td>
                    <td class="text-end">₡@group.Subtotal.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
