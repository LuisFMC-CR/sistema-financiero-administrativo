@using SistemaFinanciero.Application.Reports
@using SistemaFinanciero.Web.Models.Incomes
@using SistemaFinanciero.Web.Models.Reports
@model IncomeReportViewModel
@{
    ViewData["Title"] = "Ingresos por período";
}

<h1 class="h2 mb-1">Ingresos por período</h1>
<p class="text-body-secondary mb-3">Ingresos vigentes emitidos entre dos fechas (regla de negocio 8).</p>

<form method="get" asp-action="Income" class="row gy-2 gx-3 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-0" for="periodFrom">Desde</label>
        <input class="form-control form-control-sm" type="date" id="periodFrom" name="periodFrom" value="@Model.PeriodFrom.ToString("yyyy-MM-dd")" required />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="periodTo">Hasta</label>
        <input class="form-control form-control-sm" type="date" id="periodTo" name="periodTo" value="@Model.PeriodTo.ToString("yyyy-MM-dd")" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Consultar</button>
    </div>
    @if (Model.Result is not null)
    {
        <div class="col-auto">
            <a class="btn btn-outline-secondary btn-sm" asp-action="IncomePdf" asp-route-periodFrom="@Model.PeriodFrom.ToString("yyyy-MM-dd")" asp-route-periodTo="@Model.PeriodTo.ToString("yyyy-MM-dd")">Exportar PDF</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="IncomeExcel" asp-route-periodFrom="@Model.PeriodFrom.ToString("yyyy-MM-dd")" asp-route-periodTo="@Model.PeriodTo.ToString("yyyy-MM-dd")">Exportar Excel</a>
        </div>
    }
</form>

@if (Model.Result is IncomeReportResult result)
{
    <div class="table-responsive bg-white border rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Fecha</th>
                    <th scope="col">Categoría</th>
                    <th scope="col">Cuenta de efectivo</th>
                    <th scope="col">Origen</th>
                    <th scope="col">Referencia</th>
                    <th scope="col" class="text-end">Monto</th>
                </tr>
            </thead>
            <tbody>
                @if (result.Lines.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-body-secondary py-4">No hay ingresos vigentes en el período indicado.</td></tr>
                }
                @foreach (IncomeReportLine line in result.Lines)
                {
                    <tr>
                        <td>@line.Code</td>
                        <td>@line.IncomeDate.ToString("dd/MM/yyyy")</td>
                        <td>@line.CategoryName</td>
                        <td>@line.CashAccountName</td>
                        <td>@line.Origin.ToDisplayName()</td>
                        <td>@(line.Reference ?? "—")</td>
                        <td class="text-end">₡@line.Amount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            @if (result.Lines.Count > 0)
            {
                <tfoot>
                    <tr class="fw-semibold">
                        <td colspan="6" class="text-end">Total</td>
                        <td class="text-end">₡@result.TotalAmount.ToString("N2")</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
}
