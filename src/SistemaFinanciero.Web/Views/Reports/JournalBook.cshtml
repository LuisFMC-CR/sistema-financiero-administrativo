@using SistemaFinanciero.Application.Reports
@using SistemaFinanciero.Web.Models.Reports
@model JournalBookReportViewModel
@{
    ViewData["Title"] = "Libro diario";
    JournalBookReportResult? result = Model.Result;
}

<h1 class="h2 mb-1">Libro diario</h1>
<p class="text-body-secondary mb-3">Todos los asientos contables de un rango de fechas, con sus líneas (RF-80).</p>

<form method="get" asp-action="JournalBook" class="row gy-2 gx-3 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-0" for="periodFrom">Desde</label>
        <input class="form-control form-control-sm" type="date" id="periodFrom" name="periodFrom" value="@Model.PeriodFrom.ToString("yyyy-MM-dd")" required />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="periodTo">Hasta</label>
        <input class="form-control form-control-sm" type="date" id="periodTo" name="periodTo" value="@Model.PeriodTo.ToString("yyyy-MM-dd")" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Consultar</button>
    </div>
    @if (result is not null && result.Entries.Count > 0)
    {
        <div class="col-auto">
            <a class="btn btn-outline-secondary btn-sm" asp-action="JournalBookPdf" asp-route-periodFrom="@Model.PeriodFrom.ToString("yyyy-MM-dd")" asp-route-periodTo="@Model.PeriodTo.ToString("yyyy-MM-dd")">Exportar PDF</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="JournalBookExcel" asp-route-periodFrom="@Model.PeriodFrom.ToString("yyyy-MM-dd")" asp-route-periodTo="@Model.PeriodTo.ToString("yyyy-MM-dd")">Exportar Excel</a>
        </div>
    }
</form>

@if (result is not null)
{
    @if (result.Entries.Count == 0)
    {
        <p class="text-body-secondary text-center py-4">No hay asientos contables en el período indicado.</p>
    }
    else
    {
        @foreach (JournalBookEntry entry in result.Entries)
        {
            <div class="card mb-3">
                <div class="card-header d-flex flex-wrap justify-content-between gap-2">
                    <span><strong>Asiento @entry.Number</strong> — @entry.EntryDate.ToString("dd/MM/yyyy") — @entry.SourceType.ToDisplayName()</span>
                    <span>@entry.Description</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Cuenta</th>
                                <th scope="col" class="text-end">Débito</th>
                                <th scope="col" class="text-end">Crédito</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (JournalBookLine line in entry.Lines)
                            {
                                <tr>
                                    <td>@line.AccountCode — @line.AccountName</td>
                                    <td class="text-end">@(line.Debit > 0 ? $"₡{line.Debit:N2}" : "—")</td>
                                    <td class="text-end">@(line.Credit > 0 ? $"₡{line.Credit:N2}" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <p class="text-end fw-semibold">
            Total débitos: ₡@result.TotalDebit.ToString("N2") — Total créditos: ₡@result.TotalCredit.ToString("N2")
        </p>

        <p class="text-body-secondary"><small>Saldos calculados a partir de las operaciones registradas en el sistema; no incluye saldos iniciales.</small></p>
    }
}
