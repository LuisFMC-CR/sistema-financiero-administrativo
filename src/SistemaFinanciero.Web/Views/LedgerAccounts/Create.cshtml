@model LedgerAccountCreateViewModel
@{
    ViewData["Title"] = "Nueva cuenta contable";
}

<div class="catalog-form">
    <h1 class="h2">Nueva cuenta contable</h1>
    <p class="text-body-secondary">El código y el tipo los asigna el sistema a partir de la cuenta superior elegida; el subtipo de efectivo queda fijo después de crear la cuenta.</p>
    <form asp-action="Create" method="post" class="card card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ParentId" class="form-label"></label>
                <select asp-for="ParentId" id="ledger-account-parent" class="form-select">
                    <option value="">Seleccione un grupo</option>
                    @foreach (LedgerAccountParentOptionViewModel option in Model.ParentOptions)
                    {
                        <option value="@option.Id" data-account-type="@option.Type">@option.Label</option>
                    }
                </select>
                <span asp-validation-for="ParentId" class="text-danger"></span>
                <div class="form-text">Solo se agregan cuentas de detalle dentro de un grupo del catálogo base.</div>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsCash" id="ledger-account-is-cash" class="form-check-input" />
                    <label asp-for="IsCash" class="form-check-label"></label>
                </div>
                <span asp-validation-for="IsCash" class="text-danger"></span>
                <div class="form-text">Solo las cuentas de tipo Activo pueden ser de efectivo.</div>
            </div>
            <div class="col-12" id="ledger-account-cash-fields">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CashKind" class="form-label"></label>
                        <select asp-for="CashKind" class="form-select">
                            <option value="Cash">Caja</option>
                            <option value="Bank">Cuenta bancaria</option>
                        </select>
                        <span asp-validation-for="CashKind" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Reference" class="form-label"></label>
                <input asp-for="Reference" class="form-control" autocomplete="off" />
                <span asp-validation-for="Reference" class="text-danger"></span>
                <div class="form-text">Puede ser una referencia interna o los últimos dígitos; no ingrese credenciales bancarias.</div>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar cuenta</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
