@model CatalogIndexViewModel<LedgerAccountModel>
@{
    ViewData["Title"] = "Cuentas contables";
    bool canManage = (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ManageBusinessCatalogs)).Succeeded;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="h2 mb-1">Cuentas contables</h1>
        <p class="text-body-secondary mb-0">Catálogo jerárquico que clasifica; incluye las cajas y bancos. No lleva partida doble.</p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">Nueva cuenta contable</a>
    }
</div>

<div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">Código</th>
                <th scope="col">Nombre</th>
                <th scope="col">Tipo</th>
                <th scope="col">Cuenta superior</th>
                <th scope="col">Efectivo</th>
                <th scope="col">Estado</th>
                @if (canManage)
                {
                    <th scope="col" class="text-end">Acciones</th>
                }
            </tr>
            <partial name="_CatalogFilters" model="new CatalogFilterViewModel(Model.Search, Model.Status)" />
        </thead>
        <tbody>
            @if (Model.Results.Items.Count == 0)
            {
                <tr><td colspan="@(canManage ? 7 : 6)" class="text-center text-body-secondary py-4">No se encontraron cuentas contables.</td></tr>
            }
            @foreach (LedgerAccountModel account in Model.Results.Items)
            {
                <tr>
                    <td class="fw-semibold">@account.Code</td>
                    <td>
                        @account.Name
                        @if (account.IsProtected)
                        {
                            <span class="badge text-bg-secondary ms-1">Grupo</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(account.Reference))
                        {
                            <div class="small text-body-secondary">@account.Reference</div>
                        }
                    </td>
                    <td>@account.Type.ToDisplayName()</td>
                    <td>@(account.ParentName ?? "—")</td>
                    <td>
                        @if (account.CashKind is CashAccountKind cashKind)
                        {
                            @cashKind.ToDisplayName()
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                    <td><partial name="_CatalogStatusBadge" model="account.IsActive" /></td>
                    @if (canManage)
                    {
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@account.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (!account.IsProtected)
                            {
                                <form asp-action="SetActive" asp-route-id="@account.Id" method="post" class="d-inline js-confirm-form"
                                      data-confirm-message="¿Confirma que desea @(account.IsActive ? "desactivar" : "reactivar") esta cuenta contable?">
                                    <input type="hidden" name="IsActive" value="@(!account.IsActive)" />
                                    <input type="hidden" name="Version" value="@account.Version" />
                                    <button type="submit" class="btn btn-sm @(account.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(account.IsActive ? "Desactivar" : "Reactivar")
                                    </button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_CatalogPagination" model="new CatalogPaginationViewModel(Model.Results.Page, Model.Results.TotalPages, Model.Results.HasPreviousPage, Model.Results.HasNextPage, Model.Search, Model.Status)" />
