@model LedgerAccountEditViewModel
@{
    ViewData["Title"] = "Editar cuenta contable";
}

<div class="catalog-form">
    <h1 class="h2">Editar cuenta contable</h1>
    @if (Model.IsProtected)
    {
        <p class="text-body-secondary">Esta es una cuenta de grupo del catálogo base: no se puede modificar ni desactivar.</p>
    }
    else
    {
        <p class="text-body-secondary">El código, el tipo y la cuenta superior no pueden modificarse.</p>
    }
    <form method="post" asp-antiforgery="true" class="card card-body">
        <input asp-for="Version" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Código</label>
                <input value="@Model.Code" class="form-control" readonly />
            </div>
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" readonly="@Model.IsProtected" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Tipo</label>
                <input value="@Model.Type.ToDisplayName()" class="form-control" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label">Cuenta superior</label>
                <input value="@(Model.ParentName ?? "—")" class="form-control" readonly />
            </div>
            @if (Model.CashKind is CashAccountKind cashKind)
            {
                <div class="col-md-6">
                    <label class="form-label">Subtipo de efectivo</label>
                    <input value="@cashKind.ToDisplayName()" class="form-control" readonly />
                </div>
            }
            <div class="col-12">
                <label asp-for="Reference" class="form-label"></label>
                <input asp-for="Reference" class="form-control" autocomplete="off" readonly="@Model.IsProtected" />
                <span asp-validation-for="Reference" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3" readonly="@Model.IsProtected"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            @if (!Model.IsProtected)
            {
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
