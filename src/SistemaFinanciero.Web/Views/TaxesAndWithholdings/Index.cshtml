@using SistemaFinanciero.Application.Catalogs.Common
@using SistemaFinanciero.Application.Catalogs.TaxTypes
@using SistemaFinanciero.Application.Catalogs.WithholdingTypes
@model TaxesAndWithholdingsIndexViewModel
@{
    ViewData["Title"] = "Impuestos y retenciones";
}

<div class="mb-3">
    <h1 class="h2 mb-1">Impuestos y retenciones</h1>
    <p class="text-body-secondary mb-0">Tarifas de IVA de las líneas de factura y tipos de retención que un cliente aplica al pagar.</p>
</div>

<h2 class="h4">Tarifas de IVA</h2>
<div class="table-responsive bg-white border rounded mb-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">Código</th>
                <th scope="col">Nombre</th>
                <th scope="col">Código de Hacienda</th>
                <th scope="col" class="text-end">Tarifa</th>
                <th scope="col">Estado</th>
                @if (Model.CanManage)
                {
                    <th scope="col" class="text-end">Acciones</th>
                }
            </tr>
            <tr class="table-filter-row">
                <th colspan="100" class="p-2">
                    <form method="get" class="d-flex flex-wrap gap-2 align-items-center" role="search">
                        <input type="hidden" name="withholdingSearch" value="@Model.WithholdingSearch" />
                        <input type="hidden" name="withholdingStatus" value="@Model.WithholdingStatus" />
                        <input name="taxSearch"
                               value="@Model.TaxSearch"
                               maxlength="100"
                               class="form-control form-control-sm flex-grow-1"
                               style="min-width: 220px;"
                               placeholder="Buscar por código, nombre u otro dato principal"
                               aria-label="Buscar tarifas" />
                        <select name="taxStatus" class="form-select form-select-sm" style="max-width: 180px;" aria-label="Estado">
                            @foreach (CatalogStatusFilter status in Enum.GetValues<CatalogStatusFilter>())
                            {
                                <option value="@status" selected="@(status == Model.TaxStatus)">@status.ToDisplayName()</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary">Aplicar</button>
                        <a asp-action="Index"
                           asp-route-withholdingSearch="@Model.WithholdingSearch"
                           asp-route-withholdingStatus="@Model.WithholdingStatus"
                           class="btn btn-sm btn-outline-secondary">Limpiar</a>
                    </form>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model.TaxTypes.Items.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-body-secondary py-4">No se encontraron tarifas de IVA.</td></tr>
            }
            @foreach (TaxTypeModel taxType in Model.TaxTypes.Items)
            {
                <tr>
                    <td class="fw-semibold">@taxType.Code</td>
                    <td>
                        @taxType.Name
                        @if (!string.IsNullOrWhiteSpace(taxType.Description))
                        {
                            <div class="small text-body-secondary">@taxType.Description</div>
                        }
                    </td>
                    <td>@(taxType.HaciendaRateCode ?? "—")</td>
                    <td class="text-end text-nowrap">@taxType.Rate.ToString("0.####") %</td>
                    <td><partial name="_CatalogStatusBadge" model="taxType.IsActive" /></td>
                    @if (Model.CanManage)
                    {
                        <td class="text-end text-nowrap">
                            <a asp-action="EditTaxType" asp-route-id="@taxType.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (taxType.SystemRole is null)
                            {
                                <form asp-action="SetTaxTypeActive" asp-route-id="@taxType.Id" method="post" class="d-inline js-confirm-form"
                                      data-confirm-message="¿Confirma que desea @(taxType.IsActive ? "desactivar" : "reactivar") esta tarifa?">
                                    <input type="hidden" name="IsActive" value="@(!taxType.IsActive)" />
                                    <input type="hidden" name="Version" value="@taxType.Version" />
                                    <button type="submit" class="btn btn-sm @(taxType.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(taxType.IsActive ? "Desactivar" : "Reactivar")
                                    </button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model.TaxTypes.TotalPages > 1)
{
    <nav aria-label="Paginación de tarifas de IVA" class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <span class="text-body-secondary">Página @Model.TaxTypes.Page de @Model.TaxTypes.TotalPages</span>
        <ul class="pagination mb-0">
            <li class="page-item @(!Model.TaxTypes.HasPreviousPage ? "disabled" : null)">
                <a class="page-link" asp-action="Index"
                   asp-route-taxSearch="@Model.TaxSearch" asp-route-taxStatus="@Model.TaxStatus" asp-route-taxPage="@(Model.TaxTypes.Page - 1)"
                   asp-route-withholdingSearch="@Model.WithholdingSearch" asp-route-withholdingStatus="@Model.WithholdingStatus">Anterior</a>
            </li>
            <li class="page-item @(!Model.TaxTypes.HasNextPage ? "disabled" : null)">
                <a class="page-link" asp-action="Index"
                   asp-route-taxSearch="@Model.TaxSearch" asp-route-taxStatus="@Model.TaxStatus" asp-route-taxPage="@(Model.TaxTypes.Page + 1)"
                   asp-route-withholdingSearch="@Model.WithholdingSearch" asp-route-withholdingStatus="@Model.WithholdingStatus">Siguiente</a>
            </li>
        </ul>
    </nav>
}
@if (Model.CanAdd)
{
    <p class="mb-4">
        <a asp-action="CreateTaxType" class="link-secondary small">Agregar otra tarifa de IVA</a>
        <span class="text-body-secondary small"> — se aplica con las reglas generales del sistema y solo queda disponible para clientes de condición Normal.</span>
    </p>
}

<h2 class="h4">Tipos de retención</h2>
<div class="table-responsive bg-white border rounded mb-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">Código</th>
                <th scope="col">Nombre</th>
                <th scope="col" class="text-end">Tarifa</th>
                <th scope="col" class="text-end">Base mínima</th>
                <th scope="col">Estado</th>
                @if (Model.CanManage)
                {
                    <th scope="col" class="text-end">Acciones</th>
                }
            </tr>
            <tr class="table-filter-row">
                <th colspan="100" class="p-2">
                    <form method="get" class="d-flex flex-wrap gap-2 align-items-center" role="search">
                        <input type="hidden" name="taxSearch" value="@Model.TaxSearch" />
                        <input type="hidden" name="taxStatus" value="@Model.TaxStatus" />
                        <input name="withholdingSearch"
                               value="@Model.WithholdingSearch"
                               maxlength="100"
                               class="form-control form-control-sm flex-grow-1"
                               style="min-width: 220px;"
                               placeholder="Buscar por código, nombre u otro dato principal"
                               aria-label="Buscar retenciones" />
                        <select name="withholdingStatus" class="form-select form-select-sm" style="max-width: 180px;" aria-label="Estado">
                            @foreach (CatalogStatusFilter status in Enum.GetValues<CatalogStatusFilter>())
                            {
                                <option value="@status" selected="@(status == Model.WithholdingStatus)">@status.ToDisplayName()</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary">Aplicar</button>
                        <a asp-action="Index"
                           asp-route-taxSearch="@Model.TaxSearch"
                           asp-route-taxStatus="@Model.TaxStatus"
                           class="btn btn-sm btn-outline-secondary">Limpiar</a>
                    </form>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model.WithholdingTypes.Items.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-body-secondary py-4">No se encontraron tipos de retención.</td></tr>
            }
            @foreach (WithholdingTypeModel withholdingType in Model.WithholdingTypes.Items)
            {
                <tr>
                    <td class="fw-semibold">@withholdingType.Code</td>
                    <td>
                        @withholdingType.Name
                        @if (!string.IsNullOrWhiteSpace(withholdingType.Description))
                        {
                            <div class="small text-body-secondary">@withholdingType.Description</div>
                        }
                    </td>
                    <td class="text-end text-nowrap">@withholdingType.Rate.ToString("0.####") %</td>
                    <td class="text-end text-nowrap">@(withholdingType.MinimumBase is decimal minimumBase ? $"₡{minimumBase:N2}" : "—")</td>
                    <td><partial name="_CatalogStatusBadge" model="withholdingType.IsActive" /></td>
                    @if (Model.CanManage)
                    {
                        <td class="text-end text-nowrap">
                            <a asp-action="EditWithholdingType" asp-route-id="@withholdingType.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (!withholdingType.IsSystemType)
                            {
                                <form asp-action="SetWithholdingTypeActive" asp-route-id="@withholdingType.Id" method="post" class="d-inline js-confirm-form"
                                      data-confirm-message="¿Confirma que desea @(withholdingType.IsActive ? "desactivar" : "reactivar") este tipo de retención?">
                                    <input type="hidden" name="IsActive" value="@(!withholdingType.IsActive)" />
                                    <input type="hidden" name="Version" value="@withholdingType.Version" />
                                    <button type="submit" class="btn btn-sm @(withholdingType.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(withholdingType.IsActive ? "Desactivar" : "Reactivar")
                                    </button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model.WithholdingTypes.TotalPages > 1)
{
    <nav aria-label="Paginación de tipos de retención" class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <span class="text-body-secondary">Página @Model.WithholdingTypes.Page de @Model.WithholdingTypes.TotalPages</span>
        <ul class="pagination mb-0">
            <li class="page-item @(!Model.WithholdingTypes.HasPreviousPage ? "disabled" : null)">
                <a class="page-link" asp-action="Index"
                   asp-route-withholdingSearch="@Model.WithholdingSearch" asp-route-withholdingStatus="@Model.WithholdingStatus" asp-route-withholdingPage="@(Model.WithholdingTypes.Page - 1)"
                   asp-route-taxSearch="@Model.TaxSearch" asp-route-taxStatus="@Model.TaxStatus">Anterior</a>
            </li>
            <li class="page-item @(!Model.WithholdingTypes.HasNextPage ? "disabled" : null)">
                <a class="page-link" asp-action="Index"
                   asp-route-withholdingSearch="@Model.WithholdingSearch" asp-route-withholdingStatus="@Model.WithholdingStatus" asp-route-withholdingPage="@(Model.WithholdingTypes.Page + 1)"
                   asp-route-taxSearch="@Model.TaxSearch" asp-route-taxStatus="@Model.TaxStatus">Siguiente</a>
            </li>
        </ul>
    </nav>
}
@if (Model.CanAdd)
{
    <p class="mb-0">
        <a asp-action="CreateWithholdingType" class="link-secondary small">Agregar otro tipo de retención</a>
        <span class="text-body-secondary small"> — se aplica con las reglas generales del sistema.</span>
    </p>
}
