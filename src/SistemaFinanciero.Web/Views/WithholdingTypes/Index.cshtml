@model CatalogIndexViewModel<WithholdingTypeModel>
@{
    ViewData["Title"] = "Tipos de retención";
    bool canManage = (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ManageBusinessCatalogs)).Succeeded;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="h2 mb-1">Tipos de retención</h1>
        <p class="text-body-secondary mb-0">Retenciones con tarifa porcentual que se aplican al registrar un abono o un pago.</p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">Nuevo tipo de retención</a>
    }
</div>

<partial name="_CatalogFilters" model="new CatalogFilterViewModel(Model.Search, Model.Status)" />

<div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">Código</th>
                <th scope="col">Nombre</th>
                <th scope="col" class="text-end">Tarifa</th>
                <th scope="col">Estado</th>
                @if (canManage)
                {
                    <th scope="col" class="text-end">Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Results.Items.Count == 0)
            {
                <tr><td colspan="@(canManage ? 5 : 4)" class="text-center text-body-secondary py-4">No se encontraron tipos de retención.</td></tr>
            }
            @foreach (WithholdingTypeModel withholdingType in Model.Results.Items)
            {
                <tr>
                    <td class="fw-semibold">@withholdingType.Code</td>
                    <td>
                        @withholdingType.Name
                        @if (!string.IsNullOrWhiteSpace(withholdingType.Description))
                        {
                            <div class="small text-body-secondary">@withholdingType.Description</div>
                        }
                    </td>
                    <td class="text-end text-nowrap">@withholdingType.Rate.ToString("0.####", System.Globalization.CultureInfo.CurrentCulture) %</td>
                    <td><partial name="_CatalogStatusBadge" model="withholdingType.IsActive" /></td>
                    @if (canManage)
                    {
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@withholdingType.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <form asp-action="SetActive" asp-route-id="@withholdingType.Id" method="post" class="d-inline js-confirm-form"
                                  data-confirm-message="¿Confirma que desea @(withholdingType.IsActive ? "desactivar" : "reactivar") este tipo de retención?">
                                <input type="hidden" name="IsActive" value="@(!withholdingType.IsActive)" />
                                <input type="hidden" name="Version" value="@withholdingType.Version" />
                                <button type="submit" class="btn btn-sm @(withholdingType.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(withholdingType.IsActive ? "Desactivar" : "Reactivar")
                                </button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_CatalogPagination" model="new CatalogPaginationViewModel(Model.Results.Page, Model.Results.TotalPages, Model.Results.HasPreviousPage, Model.Results.HasNextPage, Model.Search, Model.Status)" />
