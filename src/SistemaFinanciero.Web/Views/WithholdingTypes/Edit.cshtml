@model WithholdingTypeEditViewModel
@{
    ViewData["Title"] = "Editar tipo de retención";
}

<div class="catalog-form">
    <h1 class="h2">Editar tipo de retención</h1>
    <p class="text-body-secondary">Los cambios no alteran los abonos o pagos ya registrados: cada uno conserva la tarifa que usó.</p>
    <form method="post" asp-antiforgery="true" class="card card-body">
        <input asp-for="Version" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control text-uppercase" autocomplete="off" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Rate" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Rate" type="number" min="0" max="100" step="0.0001" class="form-control" />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="Rate" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
