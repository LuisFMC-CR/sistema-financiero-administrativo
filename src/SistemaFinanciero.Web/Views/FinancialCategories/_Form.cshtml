@model FinancialCategoryInputViewModel

<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control text-uppercase" autocomplete="off" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Kind" class="form-label"></label>
        <select asp-for="Kind" id="financial-category-kind" class="form-select">
            <option value="Income">Ingreso</option>
            <option value="Expense">Gasto</option>
        </select>
        <span asp-validation-for="Kind" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ParentId" class="form-label"></label>
        <select asp-for="ParentId" id="financial-category-parent" class="form-select">
            <option value="">Sin categoría padre</option>
            @foreach (FinancialCategoryParentOptionViewModel option in Model.ParentOptions)
            {
                <option value="@option.Id" data-category-kind="@option.Kind">@option.Label</option>
            }
        </select>
        <span asp-validation-for="ParentId" class="text-danger"></span>
        <div class="form-text">Solo se muestran categorías de la misma naturaleza.</div>
    </div>
    <div class="col-12">
        <label asp-for="LedgerAccountId" class="form-label"></label>
        <select asp-for="LedgerAccountId" id="financial-category-ledger-account" class="form-select">
            <option value="">Seleccione una cuenta contable</option>
            @foreach (FinancialCategoryLedgerAccountOptionViewModel option in Model.LedgerAccountOptions)
            {
                <option value="@option.Id" data-category-kind="@option.Kind">@option.Label</option>
            }
        </select>
        <span asp-validation-for="LedgerAccountId" class="text-danger"></span>
        <div class="form-text">Una categoría de ingreso usa una cuenta de tipo Ingreso; una de gasto, una de tipo Gasto.</div>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</div>

