@model CatalogItemInputViewModel
@{
    ViewData["Title"] = "Nuevo producto o servicio";
}

<div class="catalog-form">
    <h1 class="h2">Nuevo producto o servicio</h1>
    <p class="text-body-secondary">Los productos son facturables, pero este sistema no controla existencias.</p>
    <form asp-action="Create" method="post" class="card card-body">
        <partial name="_Form" model="Model" />
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar elemento</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

