@model CatalogIndexViewModel<CatalogItemModel>
@{
    ViewData["Title"] = "Productos y servicios";
    bool canManage = (await AuthorizationService.AuthorizeAsync(User, SystemPolicies.ManageBusinessCatalogs)).Succeeded;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="h2 mb-1">Productos y servicios</h1>
        <p class="text-body-secondary mb-0">Catálogo facturable sin control de inventario.</p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">Nuevo producto o servicio</a>
    }
</div>

<partial name="_CatalogFilters" model="new CatalogFilterViewModel(Model.Search, Model.Status)" />

<div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">Código</th>
                <th scope="col">Nombre</th>
                <th scope="col">Tipo</th>
                <th scope="col">Unidad</th>
                <th scope="col" class="text-end">Precio CRC</th>
                <th scope="col" class="text-end">Precio USD</th>
                <th scope="col">Estado</th>
                @if (canManage)
                {
                    <th scope="col" class="text-end">Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Results.Items.Count == 0)
            {
                <tr><td colspan="@(canManage ? 8 : 7)" class="text-center text-body-secondary py-4">No se encontraron productos o servicios.</td></tr>
            }
            @foreach (CatalogItemModel item in Model.Results.Items)
            {
                <tr>
                    <td class="fw-semibold">@item.Code</td>
                    <td>
                        <div>@item.Name</div>
                        @if (!string.IsNullOrWhiteSpace(item.DefaultIncomeCategoryName))
                        {
                            <small class="text-body-secondary">@item.DefaultIncomeCategoryName</small>
                        }
                    </td>
                    <td>@item.Type.ToDisplayName()</td>
                    <td>@item.UnitOfMeasure</td>
                    <td class="text-end">@(item.ReferencePriceCrc?.ToString("N4") ?? "—")</td>
                    <td class="text-end">@(item.ReferencePriceUsd?.ToString("N4") ?? "—")</td>
                    <td><partial name="_CatalogStatusBadge" model="item.IsActive" /></td>
                    @if (canManage)
                    {
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <form asp-action="SetActive" asp-route-id="@item.Id" method="post" class="d-inline js-confirm-form"
                                  data-confirm-message="¿Confirma que desea @(item.IsActive ? "desactivar" : "reactivar") este elemento?">
                                <input type="hidden" name="IsActive" value="@(!item.IsActive)" />
                                <input type="hidden" name="Version" value="@item.Version" />
                                <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(item.IsActive ? "Desactivar" : "Reactivar")
                                </button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_CatalogPagination" model="new CatalogPaginationViewModel(Model.Results.Page, Model.Results.TotalPages, Model.Results.HasPreviousPage, Model.Results.HasNextPage, Model.Search, Model.Status)" />

