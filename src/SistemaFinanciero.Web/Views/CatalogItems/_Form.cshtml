@model CatalogItemInputViewModel

<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control text-uppercase" autocomplete="off" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" class="form-select">
            <option value="Product">Producto</option>
            <option value="Service">Servicio</option>
        </select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="UnitOfMeasure" class="form-label"></label>
        <input asp-for="UnitOfMeasure" class="form-control" placeholder="Ej. unidad, hora, mes" />
        <span asp-validation-for="UnitOfMeasure" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DefaultIncomeCategoryId" class="form-label"></label>
        <select asp-for="DefaultIncomeCategoryId" asp-items="Model.IncomeCategoryOptions" class="form-select">
            <option value="">Sin categoría predeterminada</option>
        </select>
        <span asp-validation-for="DefaultIncomeCategoryId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ReferencePriceCrc" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">CRC</span>
            <input asp-for="ReferencePriceCrc" type="number" min="0.0001" step="0.0001" class="form-control" />
        </div>
        <span asp-validation-for="ReferencePriceCrc" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ReferencePriceUsd" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">USD</span>
            <input asp-for="ReferencePriceUsd" type="number" min="0.0001" step="0.0001" class="form-control" />
        </div>
        <span asp-validation-for="ReferencePriceUsd" class="text-danger"></span>
    </div>
    <div class="col-12">
        <div class="form-text mb-2">Los precios son referencias independientes; no se convierten automáticamente entre monedas.</div>
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</div>

