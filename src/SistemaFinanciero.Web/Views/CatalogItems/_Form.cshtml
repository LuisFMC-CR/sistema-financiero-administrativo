@model CatalogItemInputViewModel

<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="row g-3">
    @if (Model is CatalogItemEditViewModel editModel)
    {
        <div class="col-md-4">
            <label class="form-label">Código</label>
            <input type="text" class="form-control" value="@editModel.Code" disabled readonly />
        </div>
        <div class="col-md-8">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    }
    else
    {
        <div class="col-md-12">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    }
    <div class="col-md-4">
        <label class="form-label">Tipo</label>
        @if (Model is CatalogItemEditViewModel)
        {
            <input type="text" class="form-control" value="@(Model.Type == CatalogItemType.Product ? "Producto" : "Servicio")" disabled readonly />
            <div class="form-text">El tipo no se puede modificar una vez creado el producto o servicio.</div>
        }
        else
        {
            <select asp-for="Type" class="form-select">
                <option value="Product">Producto</option>
                <option value="Service">Servicio</option>
            </select>
            <span asp-validation-for="Type" class="text-danger"></span>
        }
    </div>
    <div class="col-md-4">
        <label asp-for="UnitOfMeasure" class="form-label"></label>
        <input asp-for="UnitOfMeasure" class="form-control" placeholder="Ej. unidad, hora, mes" />
        <span asp-validation-for="UnitOfMeasure" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DefaultIncomeCategoryId" class="form-label"></label>
        <select asp-for="DefaultIncomeCategoryId" asp-items="Model.IncomeCategoryOptions" class="form-select">
            <option value="">Sin categoría predeterminada</option>
        </select>
        <span asp-validation-for="DefaultIncomeCategoryId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ReferencePriceCrc" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">₡</span>
            <input asp-for="ReferencePriceCrc" type="number" min="0.0001" step="0.0001" class="form-control" />
        </div>
        <span asp-validation-for="ReferencePriceCrc" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DefaultTaxTypeId" class="form-label"></label>
        <select asp-for="DefaultTaxTypeId" asp-items="Model.DefaultTaxTypeOptions" class="form-select">
            <option value="">Sin tarifa de IVA predeterminada</option>
        </select>
        <span asp-validation-for="DefaultTaxTypeId" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</div>

