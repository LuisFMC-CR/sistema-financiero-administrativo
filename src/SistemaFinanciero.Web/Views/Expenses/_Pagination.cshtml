@using SistemaFinanciero.Web.Models.Expenses
@model ExpenseIndexViewModel

@if (Model.Results.TotalPages > 1)
{
    <nav aria-label="Paginación de gastos" class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <span class="text-body-secondary">Página @Model.Results.Page de @Model.Results.TotalPages</span>
        <ul class="pagination mb-0">
            <li class="page-item @(!Model.Results.HasPreviousPage ? "disabled" : null)">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-code="@Model.Query.Code"
                   asp-route-supplierName="@Model.Query.SupplierName"
                   asp-route-categoryName="@Model.Query.CategoryName"
                   asp-route-issueDateFrom="@Model.Query.IssueDateFrom"
                   asp-route-issueDateTo="@Model.Query.IssueDateTo"
                   asp-route-amountMin="@Model.Query.AmountMin"
                   asp-route-amountMax="@Model.Query.AmountMax"
                   asp-route-status="@Model.Query.Status"
                   asp-route-page="@(Model.Results.Page - 1)"
                   aria-disabled="@(!Model.Results.HasPreviousPage)">Anterior</a>
            </li>
            <li class="page-item @(!Model.Results.HasNextPage ? "disabled" : null)">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-code="@Model.Query.Code"
                   asp-route-supplierName="@Model.Query.SupplierName"
                   asp-route-categoryName="@Model.Query.CategoryName"
                   asp-route-issueDateFrom="@Model.Query.IssueDateFrom"
                   asp-route-issueDateTo="@Model.Query.IssueDateTo"
                   asp-route-amountMin="@Model.Query.AmountMin"
                   asp-route-amountMax="@Model.Query.AmountMax"
                   asp-route-status="@Model.Query.Status"
                   asp-route-page="@(Model.Results.Page + 1)"
                   aria-disabled="@(!Model.Results.HasNextPage)">Siguiente</a>
            </li>
        </ul>
    </nav>
}
