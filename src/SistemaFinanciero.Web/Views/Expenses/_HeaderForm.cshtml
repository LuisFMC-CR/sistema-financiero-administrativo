@using SistemaFinanciero.Domain.Common
@using SistemaFinanciero.Domain.Invoices
@using SistemaFinanciero.Web.Models.Expenses
@using SistemaFinanciero.Web.Models.Invoices
@model ExpenseCreateViewModel

<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="SupplierId" class="form-label"></label>
        <select asp-for="SupplierId" asp-items="Model.SupplierOptions" class="form-select">
            <option value="">Seleccione un proveedor</option>
        </select>
        <span asp-validation-for="SupplierId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
            <option value="">Seleccione una categoría</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <div class="col-md-12">
        <label asp-for="Description" class="form-label"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="IssueDate" class="form-label"></label>
        <input asp-for="IssueDate" type="date" class="form-control" />
        <span asp-validation-for="IssueDate" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="PaymentTerm" class="form-label"></label>
        <select asp-for="PaymentTerm" class="form-select">
            @foreach (PaymentTerm term in Enum.GetValues<PaymentTerm>())
            {
                <option value="@term">@term.ToDisplayName()</option>
            }
        </select>
        <span asp-validation-for="PaymentTerm" class="text-danger"></span>
        <div class="form-text">El vencimiento se calcula automáticamente a partir de la fecha y el plazo elegido.</div>
    </div>
    <div class="col-md-3">
        <label asp-for="NetAmount" class="form-label"></label>
        <input asp-for="NetAmount" type="number" step="0.01" min="0.01" class="form-control" />
        <span asp-validation-for="NetAmount" class="text-danger"></span>
        <div class="form-text">Se registra sin IVA; el sistema calcula el impuesto y el total.</div>
    </div>
    <div class="col-md-3">
        <label asp-for="TaxTypeId" class="form-label"></label>
        <select asp-for="TaxTypeId" asp-items="Model.TaxTypeOptions" class="form-select">
            <option value="">Seleccione una tarifa</option>
        </select>
        <span asp-validation-for="TaxTypeId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="PaymentMethod" class="form-label"></label>
        <select asp-for="PaymentMethod" class="form-select">
            @foreach (PaymentMethod method in Enum.GetValues<PaymentMethod>())
            {
                <option value="@method">@method.ToDisplayName()</option>
            }
        </select>
        <span asp-validation-for="PaymentMethod" class="text-danger"></span>
        <div class="form-text">No se vuelve a pedir al confirmar de contado (regla 7).</div>
    </div>
</div>
