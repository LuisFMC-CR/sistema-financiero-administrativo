@model JournalEntryTraceModel
@{
    ViewData["Title"] = "Asiento contable";
    (string documentController, string documentAction) = Model.Entry.DocumentKind.ToRoute();
}

<div class="mb-3 d-flex flex-wrap justify-content-between align-items-start gap-2">
    <div>
        <h1 class="h2 mb-1">Asiento contable</h1>
        <p class="text-body-secondary mb-0">
            Origen: @Model.Entry.SourceType.ToDisplayName() — @Model.Entry.Description
        </p>
    </div>
    <a asp-controller="@documentController" asp-action="@documentAction" asp-route-id="@Model.Entry.DocumentId"
       class="btn btn-outline-secondary">@Model.Entry.DocumentKind.ToLinkLabel()</a>
</div>

<partial name="_JournalEntry" model="Model.Entry" />

@if (Model.Reversal is not null)
{
    <h2 class="h5 mt-4 mb-2">Reversión</h2>
    <partial name="_JournalEntry" model="Model.Reversal" />
}
