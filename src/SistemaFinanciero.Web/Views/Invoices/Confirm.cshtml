@using SistemaFinanciero.Domain.Common
@using SistemaFinanciero.Web.Models.Invoices
@model InvoiceConfirmViewModel
@{
    ViewData["Title"] = "Confirmar factura";
}

<div class="catalog-form">
    <h1 class="h2">Confirmar factura</h1>
    <p class="text-body-secondary">
        Una vez confirmada no se puede editar. Total a confirmar: ₡@Model.TotalAmount.ToString("N2").
    </p>
    <form method="post" class="card card-body">
        <input asp-for="Version" type="hidden" />
        <input asp-for="IsCash" type="hidden" />
        <input asp-for="TotalAmount" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        @if (Model.IsCash)
        {
            <p class="text-body-secondary">Esta factura es de contado: al confirmarla se genera su ingreso.</p>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CashAccountId" class="form-label"></label>
                    <select asp-for="CashAccountId" asp-items="Model.CashAccountOptions" class="form-select">
                        <option value="">Seleccione una cuenta de efectivo</option>
                    </select>
                    <span asp-validation-for="CashAccountId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PaymentMethod" class="form-label"></label>
                    <select asp-for="PaymentMethod" class="form-select">
                        <option value="">Seleccione un medio de pago</option>
                        @foreach (PaymentMethod method in Enum.GetValues<PaymentMethod>())
                        {
                            <option value="@method">@method.ToDisplayName()</option>
                        }
                    </select>
                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Reference" class="form-label"></label>
                    <input asp-for="Reference" class="form-control" />
                    <span asp-validation-for="Reference" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                        <option value="">Seleccione una categoría</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
            </div>
        }
        else
        {
            <p class="text-body-secondary">Esta factura es a crédito: al confirmarla se genera su cuenta por cobrar.</p>
        }

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-success">Confirmar</button>
            <a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
