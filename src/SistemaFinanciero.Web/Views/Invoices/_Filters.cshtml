@using SistemaFinanciero.Application.Invoices
@using SistemaFinanciero.Domain.Invoices
@using SistemaFinanciero.Web.Models.Invoices
@model InvoiceFilterViewModel

<tr class="table-filter-row">
    <th colspan="100" class="p-2">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-center" role="search">
            <input name="search"
                   value="@Model.Search"
                   maxlength="100"
                   class="form-control form-control-sm flex-grow-1"
                   style="min-width: 220px;"
                   placeholder="Número o nombre del cliente"
                   aria-label="Buscar" />
            <select name="status" class="form-select form-select-sm" style="max-width: 180px;" aria-label="Estado">
                @foreach (InvoiceStatusFilter status in Enum.GetValues<InvoiceStatusFilter>())
                {
                    if (status == Model.Status)
                    {
                        <option value="@status" selected>@status.ToDisplayName()</option>
                    }
                    else
                    {
                        <option value="@status">@status.ToDisplayName()</option>
                    }
                }
            </select>
            <select name="paymentTerm" class="form-select form-select-sm" style="max-width: 180px;" aria-label="Plazo">
                <option value="">Todos los plazos</option>
                @foreach (PaymentTerm term in Enum.GetValues<PaymentTerm>())
                {
                    if (term == Model.PaymentTerm)
                    {
                        <option value="@term" selected>@term.ToDisplayName()</option>
                    }
                    else
                    {
                        <option value="@term">@term.ToDisplayName()</option>
                    }
                }
            </select>
            <label class="visually-hidden" for="invoice-filter-issue-date-from">Emisión desde</label>
            <input id="invoice-filter-issue-date-from"
                   name="issueDateFrom"
                   type="date"
                   value="@Model.IssueDateFrom?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm"
                   style="max-width: 160px;"
                   aria-label="Emisión desde" />
            <label class="visually-hidden" for="invoice-filter-issue-date-to">Emisión hasta</label>
            <input id="invoice-filter-issue-date-to"
                   name="issueDateTo"
                   type="date"
                   value="@Model.IssueDateTo?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm"
                   style="max-width: 160px;"
                   aria-label="Emisión hasta" />
            <button type="submit" class="btn btn-sm btn-primary">Aplicar</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Limpiar</a>
        </form>
    </th>
</tr>
