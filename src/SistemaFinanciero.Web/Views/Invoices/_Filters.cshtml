@using SistemaFinanciero.Application.Invoices
@using SistemaFinanciero.Domain.Invoices
@using SistemaFinanciero.Web.Models.Invoices
@model InvoiceFilterViewModel

<tr class="table-filter-row">
    <th class="p-2">
        <input name="number" type="number" min="1" value="@Model.Number" class="form-control form-control-sm" placeholder="Número" aria-label="Filtrar por número" />
    </th>
    <th class="p-2">
        <input name="customerName" value="@Model.CustomerName" maxlength="100" class="form-control form-control-sm" placeholder="Cliente" aria-label="Filtrar por cliente" />
    </th>
    <th class="p-2">
        <input name="issueDate" type="date" value="@Model.IssueDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="Filtrar por fecha de emisión" />
    </th>
    <th class="p-2">
        <select name="paymentTerm" class="form-select form-select-sm" aria-label="Filtrar por plazo">
            <option value="">Todos</option>
            @foreach (PaymentTerm term in Enum.GetValues<PaymentTerm>())
            {
                if (term == Model.PaymentTerm)
                {
                    <option value="@term" selected>@term.ToDisplayName()</option>
                }
                else
                {
                    <option value="@term">@term.ToDisplayName()</option>
                }
            }
        </select>
    </th>
    <th class="p-2">
        <input name="dueDate" type="date" value="@Model.DueDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="Filtrar por vencimiento" />
    </th>
    <th class="p-2">
        <select name="status" class="form-select form-select-sm" aria-label="Filtrar por estado">
            @foreach (InvoiceStatusFilter status in Enum.GetValues<InvoiceStatusFilter>())
            {
                if (status == Model.Status)
                {
                    <option value="@status" selected>@status.ToDisplayName()</option>
                }
                else
                {
                    <option value="@status">@status.ToDisplayName()</option>
                }
            }
        </select>
    </th>
    <th class="p-2">
        <input name="totalAmount" type="number" min="0" step="0.01" value="@Model.TotalAmount?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm text-end" placeholder="₡" aria-label="Filtrar por total" />
    </th>
    <th class="p-2">
        <input name="createdByUserName" value="@Model.CreatedByUserName" maxlength="100" class="form-control form-control-sm" placeholder="Usuario" aria-label="Filtrar por usuario" />
    </th>
</tr>
<tr>
    <th colspan="8" class="p-2 text-end">
        <button type="submit" class="btn btn-sm btn-primary" aria-label="Buscar facturas" title="Buscar">
            <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5" />
                <path d="m10.5 10.5 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
        </button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" aria-label="Limpiar filtros" title="Limpiar">
            <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 4h10M6 4V2.5h4V4m2 0-.6 9H4.6L4 4m2.5 2v4.5m3-4.5v4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </a>
    </th>
</tr>
