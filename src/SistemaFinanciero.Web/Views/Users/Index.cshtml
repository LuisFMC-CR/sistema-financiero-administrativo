@model UserIndexViewModel
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="h2 mb-1">Usuarios</h1>
        <p class="text-body-secondary mb-0">Cuentas internas, roles y acceso al sistema.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo usuario</a>
</div>

<partial name="_Filters" model="new UserFilterViewModel(Model.Search, Model.Status, Model.Role, Model.Roles)" />

<div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">Nombre</th>
                <th scope="col">Correo electrónico</th>
                <th scope="col">Rol</th>
                <th scope="col">Acceso</th>
                <th scope="col">Estado</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Results.Items.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-body-secondary py-4">No se encontraron usuarios.</td>
                </tr>
            }
            @foreach (UserModel user in Model.Results.Items)
            {
                bool isCurrentUser = user.Id == Model.CurrentUserId;
                <tr>
                    <td>
                        <span class="fw-semibold">@user.FullName</span>
                        @if (isCurrentUser)
                        {
                            <span class="badge text-bg-light border ms-1">Su cuenta</span>
                        }
                    </td>
                    <td>@user.Email</td>
                    <td><span class="badge text-bg-secondary">@user.Role</span></td>
                    <td>
                        @if (user.IsLockedOut)
                        {
                            <span class="badge text-bg-warning">Bloqueo temporal</span>
                            @if (user.LockoutEndUtc is not null)
                            {
                                <small class="d-block text-body-secondary mt-1">
                                    Hasta @user.LockoutEndUtc.Value.ToLocalTime().ToString("g")
                                </small>
                            }
                        }
                        else if (user.MustChangePassword)
                        {
                            <span class="badge text-bg-info">Cambio de contraseña pendiente</span>
                        }
                        else
                        {
                            <span class="text-body-secondary">Disponible</span>
                        }
                    </td>
                    <td><partial name="_CatalogStatusBadge" model="user.IsActive" /></td>
                    <td class="text-end">
                        <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Editar</a>

                            @if (!isCurrentUser)
                            {
                                <a asp-action="ResetPassword"
                                   asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-secondary">Restablecer contraseña</a>

                                @if (user.IsLockedOut)
                                {
                                    <form asp-action="Unlock"
                                          asp-route-id="@user.Id"
                                          method="post"
                                          class="d-inline js-confirm-form"
                                          data-confirm-message="¿Confirma que desea eliminar el bloqueo temporal de esta cuenta?">
                                        <input type="hidden" name="Version" value="@user.Version" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Desbloquear</button>
                                    </form>
                                }

                                <form asp-action="SetActive"
                                      asp-route-id="@user.Id"
                                      method="post"
                                      class="d-inline js-confirm-form"
                                      data-confirm-message="¿Confirma que desea @(user.IsActive ? "desactivar" : "reactivar") esta cuenta?">
                                    <input type="hidden" name="IsActive" value="@(!user.IsActive)" />
                                    <input type="hidden" name="Version" value="@user.Version" />
                                    <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(user.IsActive ? "Desactivar" : "Reactivar")
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination"
         model="new UserPaginationViewModel(Model.Results.Page, Model.Results.TotalPages, Model.Results.HasPreviousPage, Model.Results.HasNextPage, Model.Search, Model.Status, Model.Role)" />
