@model UserCreateViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="catalog-form catalog-form-narrow">
    <h1 class="h2">Nuevo usuario</h1>
    <p class="text-body-secondary">
        La cuenta se creará activa y deberá cambiar la contraseña temporal antes de utilizar los módulos.
    </p>

    @* Perfiles fijos del sistema; no hay permisos por usuario individual. Se muestra aquí, antes de
       elegir el rol, porque esta pantalla es la única exclusiva de Administrador: el resto de
       perfiles no administra usuarios ni necesita consultar la matriz. *@
    <h2 class="h5">Perfiles y permisos</h2>
    <div class="table-responsive bg-white border rounded mb-4">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 160px;">Perfil</th>
                    <th scope="col">Permisos</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-semibold">Asistente</td>
                    <td>
                        Consulta catálogos; mantiene clientes y proveedores; consulta facturas y gastos
                        de todos y mantiene solo sus propios borradores; registra ingresos manuales;
                        consulta cuentas por cobrar y por pagar; registra abonos, individuales o
                        repartidos entre varias facturas, hasta el límite de autorización. No confirma
                        documentos, no registra pagos ni anula, y no ve asientos, reportes ni presupuesto.
                    </td>
                </tr>
                <tr>
                    <td class="fw-semibold">Finanzas</td>
                    <td>
                        Catálogos financieros (cuentas, categorías, tarifas, retenciones, productos);
                        confirma documentos; ingresos manuales; abonos y pagos hasta el límite de
                        autorización; presupuesto; reportes y parámetros del sistema (límite de
                        autorización, días de alerta y datos de la empresa).
                    </td>
                </tr>
                <tr>
                    <td class="fw-semibold">Gerencia</td>
                    <td>
                        Todo lo de Finanzas y Asistente (incluidos los borradores de todos los
                        usuarios), más lo exclusivo: abonos y pagos sobre el límite de autorización,
                        anulaciones, ajustes de saldo y parámetros del sistema (límite de autorización,
                        días de alerta, datos de la empresa y fecha de cierre). No administra usuarios.
                    </td>
                </tr>
                <tr>
                    <td class="fw-semibold">Administrador</td>
                    <td>Solo usuarios y configuración técnica; sin acceso a información financiera.</td>
                </tr>
            </tbody>
        </table>
    </div>
    <p class="text-body-secondary small mb-4">
        Gerencia entra en toda política que permita a Finanzas o Asistente; solo las de administración
        de usuarios la excluyen. Lo exclusivo de Gerencia sigue siendo exclusivo de Gerencia. Los
        permisos se validan siempre en el servidor, no solo ocultando opciones en pantalla.
    </p>

    <form asp-action="Create" method="post" asp-antiforgery="true" class="card card-body">
        <partial name="_Form" model="Model" />

        <hr class="my-4" />
        <h2 class="h5">Acceso inicial</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="TemporaryPassword" class="form-label"></label>
                <input asp-for="TemporaryPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="TemporaryPassword" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="col-12">
                <div class="form-text">
                    Use al menos 12 caracteres, con mayúscula, minúscula, número y símbolo. Comuníquela fuera del sistema.
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Crear usuario</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
